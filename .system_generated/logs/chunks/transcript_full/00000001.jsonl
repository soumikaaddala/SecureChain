{"step_index":73,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-08T04:49:28Z","content":"Now the page components:","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { useEffect, useState } from 'react'\nimport { Link } from 'react-router-dom'\nimport {\n  BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer,\n  PieChart, Pie, Cell, Legend\n} from 'recharts'\nimport {\n  Shield, AlertTriangle, Package, Scan, Wrench, TrendingUp,\n  FolderGit2, CheckCircle2, XCircle\n} from 'lucide-react'\nimport { getDashboard, type DashboardStats } from '../api/client'\nimport { StatCard, ScanStatusBadge, SeverityBadge, Spinner, ErrorBanner } from '../components/ui'\nimport { formatDate } from '../lib/constants'\n\nconst PIE_COLORS = ['#ef4444', '#f97316', '#eab308', '#3b82f6', '#22c55e', '#6b7280']\n\nconst CHART_STYLE = {\n  fontSize: 11,\n  fill: '#94a3b8',\n}\n\nexport default function Dashboard() {\n  const [stats, setStats] = useState<DashboardStats | null>(null)\n  const [loading, setLoading] = useState(true)\n  const [error, setError] = useState('')\n\n  useEffect(() => {\n    getDashboard()\n      .then(setStats)\n      .catch(() => setError('Failed to load dashboard. Is the backend running?'))\n      .finally(() => setLoading(false))\n  }, [])\n\n  if (loading) return <Spinner />\n  if (error) return <ErrorBanner message={error} />\n  if (!stats) return null\n\n  const severityData = Object.entries(stats.severity_distribution).map(([k, v]) => ({\n    name: k.charAt(0).toUpperCase() + k.slice(1), value: v,\n  }))\n\n  const threatData = Object.entries(stats.threat_type_distribution)\n    .sort((a, b) => b[1] - a[1])\n    .map(([k, v]) => ({\n      name: k.replace(/_/g, ' ').replace(/\\b\\w/g, c => c.toUpperCase()),\n      value: v,\n    }))\n\n  const ecoData = Object.entries(stats.ecosystem_distribution).map(([k, v]) => ({\n    name: k.toUpperCase(), value: v,\n  }))\n\n  return (\n    <div className=\"p-6 space-y-6\">\n      <div>\n        <h1 className=\"text-xl font-bold text-white\">Dashboard</h1>\n        <p className=\"text-sm text-gray-400 mt-0.5\">Supply chain security overview</p>\n      </div>\n\n      {/* Stat cards */}\n      <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\n        <StatCard\n          label=\"Total Projects\"\n          value={stats.total_projects}\n          sub={`${stats.active_projects} active`}\n          icon={<FolderGit2 size={18} className=\"text-sky-400\" />}\n          color=\"text-sky-300\"\n        />\n        <StatCard\n          label=\"Dependencies\"\n          value={stats.total_dependencies.toLocaleString()}\n          icon={<Package size={18} className=\"text-purple-400\" />}\n          color=\"text-purple-300\"\n        />\n        <StatCard\n          label=\"Critical Findings\"\n          value={stats.critical_findings}\n          sub={`${stats.total_findings} total`}\n          icon={<AlertTriangle size={18} className=\"text-red-400\" />}\n          color=\"text-red-300\"\n        />\n        <StatCard\n          label=\"Open Remediations\"\n          value={stats.open_remediations}\n          sub={`${stats.resolved_remediations} resolved`}\n          icon={<Wrench size={18} className=\"text-orange-400\" />}\n          color=\"text-orange-300\"\n        />\n        <StatCard\n          label=\"Avg Risk Score\"\n          value={stats.avg_risk_score.toFixed(1)}\n          sub=\"Across all projects\"\n          icon={<TrendingUp size={18} className=\"text-yellow-400\" />}\n          color={stats.avg_risk_score >= 50 ? 'text-red-400' : 'text-yellow-300'}\n        />\n        <StatCard\n          label=\"Total Scans\"\n          value={stats.total_scans}\n          icon={<Shield size={18} className=\"text-green-400\" />}\n          color=\"text-green-300\"\n        />\n        <StatCard\n          label=\"Total Findings\"\n          value={stats.total_findings}\n          icon={<AlertTriangle size={18} className=\"text-orange-400\" />}\n        />\n        <StatCard\n          label=\"Resolved\"\n          value={stats.resolved_remediations}\n          icon={<CheckCircle2 size={18} className=\"text-green-400\" />}\n          color=\"text-green-300\"\n        />\n      </div>\n\n      {/* Charts Row */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-4\">\n        {/* Severity Distribution */}\n        <div className=\"card\">\n          <h3 className=\"text-sm font-semibold text-gray-300 mb-4\">Severity Distribution</h3>\n          {severityData.length === 0 ? (\n            <p className=\"text-gray-500 text-sm text-center py-6\">No findings yet</p>\n          ) : (\n            <ResponsiveContainer width=\"100%\" height={200}>\n              <PieChart>\n                <Pie data={severityData} cx=\"50%\" cy=\"50%\" innerRadius={55} outerRadius={80}\n                  dataKey=\"value\" labelLine={false}>\n                  {severityData.map((_, i) => (\n                    <Cell key={i} fill={PIE_COLORS[i % PIE_COLORS.length]} />\n                  ))}\n                </Pie>\n                <Tooltip contentStyle={{ background: '#1f2937', border: '1px solid #374151', borderRadius: 8 }}\n                  itemStyle={{ color: '#e2e8f0' }} />\n                <Legend wrapperStyle={CHART_STYLE} />\n              </PieChart>\n            </ResponsiveContainer>\n          )}\n        </div>\n\n        {/* Threat Type Breakdown */}\n        <div className=\"card lg:col-span-2\">\n          <h3 className=\"text-sm font-semibold text-gray-300 mb-4\">Threat Type Breakdown</h3>\n          {threatData.length === 0 ? (\n            <p className=\"text-gray-500 text-sm text-center py-6\">No findings yet</p>\n          ) : (\n            <ResponsiveContainer width=\"100%\" height={200}>\n              <BarChart data={threatData} layout=\"vertical\" margin={{ left: 20, right: 20 }}>\n                <XAxis type=\"number\" tick={CHART_STYLE} axisLine={false} tickLine={false} />\n                <YAxis type=\"category\" dataKey=\"name\" tick={{ ...CHART_STYLE, fontSize: 10 }}\n                  width={140} axisLine={false} tickLine={false} />\n                <Tooltip contentStyle={{ background: '#1f2937', border: '1px solid #374151', borderRadius: 8 }}\n                  itemStyle={{ color: '#e2e8f0' }} />\n                <Bar dataKey=\"value\" fill=\"#0ea5e9\" radius={[0, 4, 4, 0]} />\n              </BarChart>\n            </ResponsiveContainer>\n          )}\n        </div>\n      </div>\n\n      {/* Ecosystem & Recent Scans */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-4\">\n        {/* Ecosystem Distribution */}\n        <div className=\"card\">\n          <h3 className=\"text-sm font-semibold text-gray-300 mb-4\">Dependencies by Ecosystem</h3>\n          {ecoData.length === 0 ? (\n            <p className=\"text-gray-500 text-sm text-center py-6\">No dependencies yet</p>\n          ) : (\n            <ResponsiveContainer width=\"100%\" height={180}>\n              <BarChart data={ecoData}>\n                <XAxis dataKey=\"name\" tick={CHART_STYLE} axisLine={false} tickLine={false} />\n                <YAxis tick={CHART_STYLE} axisLine={false} tickLine={false} />\n                <Tooltip contentStyle={{ background: '#1f2937', border: '1px solid #374151', borderRadius: 8 }}\n                  itemStyle={{ color: '#e2e8f0' }} />\n                <Bar dataKey=\"value\" fill=\"#7c3aed\" radius={[4, 4, 0, 0]} />\n              </BarChart>\n            </ResponsiveContainer>\n          )}\n        </div>\n\n        {/* Recent Scans */}\n        <div className=\"card\">\n          <h3 className=\"text-sm font-semibold text-gray-300 mb-4\">Recent Scans</h3>\n          {stats.recent_scans.length === 0 ? (\n            <p className=\"text-gray-500 text-sm text-center py-6\">No scans yet</p>\n          ) : (\n            <div className=\"space-y-2\">\n              {stats.recent_scans.map(scan => (\n                <Link\n                  key={scan.id}\n                  to={`/scans`}\n                  className=\"flex items-center justify-between p-3 bg-gray-800/50 rounded-lg hover:bg-gray-800 transition-colors\"\n                >\n                  <div className=\"flex items-center gap-3\">\n                    <ScanStatusBadge status={scan.status} />\n                    <div>\n                      <p className=\"text-xs text-gray-300 font-medium\">Scan #{scan.id} · Project {scan.project_id}</p>\n                      <p className=\"text-xs text-gray-500\">{formatDate(scan.started_at)}</p>\n                    </div>\n                  </div>\n                  <div className=\"text-right\">\n                    <p className=\"text-xs text-red-400 font-medium\">{scan.critical_count} critical</p>\n                    <p className=\"text-xs text-gray-500\">Score: {scan.risk_score.toFixed(1)}</p>\n                  </div>\n                </Link>\n              ))}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Supply Chain Workflow Diagram */}\n      <div className=\"card\">\n        <h3 className=\"text-sm font-semibold text-gray-300 mb-4\">Supply Chain Workflow</h3>\n        <div className=\"flex items-center justify-between gap-2 overflow-x-auto pb-2\">\n          {[\n            { icon: '👨‍💻', label: 'Developer', sub: 'Code commit' },\n            { icon: '📁', label: 'Source Repo', sub: 'Version control' },\n            { icon: '🔨', label: 'Build', sub: 'CI/CD pipeline' },\n            { icon: '📦', label: 'Dependencies', sub: 'Package resolution' },\n            { icon: '🔍', label: 'Security Scan', sub: 'Vulnerability check' },\n            { icon: '📚', label: 'Artifact Repo', sub: 'Signed & stored' },\n          ].map((step, i) => (\n            <div key={i} className=\"flex items-center gap-2 flex-shrink-0\">\n              <div className=\"flex flex-col items-center gap-1 min-w-[90px]\">\n                <div className=\"w-12 h-12 rounded-xl bg-gray-800 flex items-center justify-center text-2xl\">\n                  {step.icon}\n                </div>\n                <span className=\"text-xs font-medium text-gray-300\">{step.label}</span>\n                <span className=\"text-xs text-gray-600 text-center\">{step.sub}</span>\n              </div>\n              {i < 5 && (\n                <div className=\"text-gray-700 text-lg mx-1\">→</div>\n              )}\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  )\n}\n","Description":"Dashboard page with charts and supply chain workflow visualization","Overwrite":false,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\pages\\Dashboard.tsx","toolAction":"Writing Dashboard page","toolSummary":"Dashboard page component"}}]}
