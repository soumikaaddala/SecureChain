{"step_index":65,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-08T04:48:06Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import axios from 'axios'\n\nconst api = axios.create({\n  baseURL: '/api/v1',\n  headers: { 'Content-Type': 'application/json' },\n})\n\n// ── Types ──────────────────────────────────────\n\nexport type Ecosystem = 'npm' | 'pypi' | 'maven' | 'nuget' | 'rubygems' | 'go' | 'cargo' | 'docker' | 'unknown'\nexport type Severity = 'critical' | 'high' | 'medium' | 'low' | 'none' | 'unknown'\nexport type ThreatType =\n  | 'dependency_confusion' | 'malicious_package' | 'artifact_tampering'\n  | 'build_compromise' | 'secret_leakage' | 'supply_chain_attack' | 'cve' | 'outdated' | 'license_violation'\nexport type ScanStatus = 'pending' | 'running' | 'completed' | 'failed'\nexport type RemediationStatus = 'open' | 'in_progress' | 'resolved' | 'wont_fix' | 'false_positive'\nexport type BuildStatus = 'success' | 'failure' | 'running' | 'cancelled'\n\nexport interface Project {\n  id: number\n  name: string\n  description?: string\n  repo_url?: string\n  default_branch: string\n  ecosystem: Ecosystem\n  owner?: string\n  team?: string\n  is_active: boolean\n  created_at: string\n  updated_at: string\n  total_deps?: number\n  critical_findings?: number\n  last_scan_at?: string\n  risk_score?: number\n}\n\nexport interface Dependency {\n  id: number\n  project_id: number\n  name: string\n  version: string\n  ecosystem: Ecosystem\n  is_direct: boolean\n  is_dev: boolean\n  registry_url?: string\n  package_hash?: string\n  license?: string\n  depth: number\n  is_internal: boolean\n  created_at: string\n}\n\nexport interface Build {\n  id: number\n  project_id: number\n  build_number: string\n  commit_sha?: string\n  branch?: string\n  status: BuildStatus\n  builder?: string\n  build_tool?: string\n  provenance?: Record<string, unknown>\n  secrets_detected: boolean\n  tampered: boolean\n  started_at: string\n  finished_at?: string\n}\n\nexport interface Artifact {\n  id: number\n  project_id: number\n  build_id?: number\n  name: string\n  version?: string\n  artifact_type?: string\n  sha256?: string\n  size_bytes?: number\n  registry_path?: string\n  is_signed: boolean\n  tampered: boolean\n  created_at: string\n}\n\nexport interface Scan {\n  id: number\n  project_id: number\n  scan_type: string\n  status: ScanStatus\n  triggered_by?: string\n  total_deps_scanned: number\n  critical_count: number\n  high_count: number\n  medium_count: number\n  low_count: number\n  risk_score: number\n  sbom?: Record<string, unknown>\n  started_at: string\n  completed_at?: string\n}\n\nexport interface Finding {\n  id: number\n  scan_id: number\n  dependency_id?: number\n  threat_type: ThreatType\n  severity: Severity\n  cve_id?: string\n  title: string\n  description?: string\n  affected_package: string\n  affected_version?: string\n  fixed_in_version?: string\n  cvss_score?: number\n  attack_vector?: string\n  references?: string[]\n  evidence?: Record<string, unknown>\n  created_at: string\n}\n\nexport interface Remediation {\n  id: number\n  finding_id: number\n  status: RemediationStatus\n  assigned_to?: string\n  priority: number\n  action?: string\n  notes?: string\n  target_version?: string\n  due_date?: string\n  resolved_at?: string\n  created_at: string\n  updated_at: string\n}\n\nexport interface RiskReport {\n  project_id: number\n  project_name: string\n  generated_at: string\n  risk_score: number\n  total_dependencies: number\n  direct_dependencies: number\n  transitive_dependencies: number\n  total_findings: number\n  critical_count: number\n  high_count: number\n  medium_count: number\n  low_count: number\n  threat_breakdown: Record<string, number>\n  top_findings: Finding[]\n  remediation_summary: Record<string, number>\n  sbom?: Record<string, unknown>\n  recommendations: string[]\n}\n\nexport interface DashboardStats {\n  total_projects: number\n  active_projects: number\n  total_dependencies: number\n  total_scans: number\n  total_findings: number\n  critical_findings: number\n  open_remediations: number\n  resolved_remediations: number\n  avg_risk_score: number\n  recent_scans: Scan[]\n  severity_distribution: Record<string, number>\n  threat_type_distribution: Record<string, number>\n  ecosystem_distribution: Record<string, number>\n}\n\nexport interface ThreatIntel {\n  id: number\n  package_name: string\n  ecosystem: Ecosystem\n  threat_type: ThreatType\n  severity: Severity\n  cve_id?: string\n  affected_versions?: string[]\n  description?: string\n  source?: string\n  is_active: boolean\n  created_at: string\n}\n\n// ── API Methods ────────────────────────────────\n\n// Dashboard\nexport const getDashboard = () => api.get<DashboardStats>('/dashboard').then(r => r.data)\n\n// Projects\nexport const getProjects = (params?: Record<string, unknown>) =>\n  api.get<Project[]>('/projects', { params }).then(r => r.data)\nexport const getProject = (id: number) => api.get<Project>(`/projects/${id}`).then(r => r.data)\nexport const createProject = (data: Partial<Project>) =>\n  api.post<Project>('/projects', data).then(r => r.data)\nexport const updateProject = (id: number, data: Partial<Project>) =>\n  api.patch<Project>(`/projects/${id}`, data).then(r => r.data)\nexport const deleteProject = (id: number) => api.delete(`/projects/${id}`)\n\n// Dependencies\nexport const getDependencies = (projectId: number, params?: Record<string, unknown>) =>\n  api.get<Dependency[]>(`/projects/${projectId}/dependencies`, { params }).then(r => r.data)\nexport const addDependency = (projectId: number, data: Partial<Dependency>) =>\n  api.post<Dependency>(`/projects/${projectId}/dependencies`, data).then(r => r.data)\nexport const bulkAddDependencies = (projectId: number, data: Partial<Dependency>[]) =>\n  api.post<Dependency[]>(`/projects/${projectId}/dependencies/bulk`, data).then(r => r.data)\nexport const deleteDependency = (projectId: number, depId: number) =>\n  api.delete(`/projects/${projectId}/dependencies/${depId}`)\n\n// Builds\nexport const getBuilds = (projectId: number) =>\n  api.get<Build[]>(`/projects/${projectId}/builds`).then(r => r.data)\nexport const createBuild = (projectId: number, data: Partial<Build>) =>\n  api.post<Build>(`/projects/${projectId}/builds`, data).then(r => r.data)\n\n// Artifacts\nexport const getArtifacts = (projectId: number) =>\n  api.get<Artifact[]>(`/projects/${projectId}/artifacts`).then(r => r.data)\nexport const registerArtifact = (projectId: number, data: Partial<Artifact>) =>\n  api.post<Artifact>(`/projects/${projectId}/artifacts`, data).then(r => r.data)\nexport const verifyArtifact = (projectId: number, artifactId: number, hash: string) =>\n  api.patch<Artifact>(`/projects/${projectId}/artifacts/${artifactId}/verify`, null, {\n    params: { provided_hash: hash }\n  }).then(r => r.data)\n\n// Scans\nexport const getScans = (projectId: number) =>\n  api.get<Scan[]>(`/projects/${projectId}/scans`).then(r => r.data)\nexport const triggerScan = (projectId: number, data: { scan_type?: string; triggered_by?: string }) =>\n  api.post<Scan>(`/projects/${projectId}/scans`, data).then(r => r.data)\nexport const getScan = (projectId: number, scanId: number) =>\n  api.get<Scan>(`/projects/${projectId}/scans/${scanId}`).then(r => r.data)\nexport const getFindings = (\n  projectId: number,\n  scanId: number,\n  params?: { severity?: string; threat_type?: string }\n) => api.get<Finding[]>(`/projects/${projectId}/scans/${scanId}/findings`, { params }).then(r => r.data)\n\n// Remediations\nexport const getRemediations = (findingId: number) =>\n  api.get<Remediation[]>(`/findings/${findingId}/remediations`).then(r => r.data)\nexport const createRemediation = (findingId: number, data: Partial<Remediation>) =>\n  api.post<Remediation>(`/findings/${findingId}/remediations`, data).then(r => r.data)\nexport const updateRemediation = (remId: number, data: Partial<Remediation>) =>\n  api.patch<Remediation>(`/remediations/${remId}`, data).then(r => r.data)\n\n// Risk Report\nexport const getRiskReport = (projectId: number) =>\n  api.get<RiskReport>(`/projects/${projectId}/report`).then(r => r.data)\n\n// Threat Intel\nexport const getThreatIntel = () =>\n  api.get<ThreatIntel[]>('/threat-intel').then(r => r.data)\nexport const addThreatIntel = (data: Partial<ThreatIntel>) =>\n  api.post<ThreatIntel>('/threat-intel', data).then(r => r.data)\n\nexport default api\n","Description":"Typed API client with all endpoint methods","Overwrite":false,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\api\\client.ts","toolAction":"Writing API client","toolSummary":"Frontend API client"}}]}
