dleware.cors import CORSMiddleware\n\nfrom app.db import init_db\nfrom app.core.scanner import seed_threat_intel\nfrom app.db.database import SessionLocal\nfrom app.api import (\n    projects_router,\n    deps_router,\n    scans_router,\n    builds_router,\n    dashboard_router,\n)\n\n\n@asynccontextmanager\nasync def lifespan(app: FastAPI):\n    \"\"\"Initialize database and seed threat intel on startup.\"\"\"\n    init_db()\n    db = SessionLocal()\n    try:\n        seed_threat_intel(db)\n    finally:\n        db.close()\n    yield\n\n\napp = FastAPI(\n    title=\"SecureChain — Supply Chain Security Platform\",\n    description=(\n        \"A comprehensive platform for managing software dependencies, \"\n        \"build artifacts, vulnerability scanning, and supply chain threat detection.\"\n    ),\n    version=\"1.0.0\",\n    lifespan=lifespan,\n    docs_url=\"/docs\",\n    redoc_url=\"/redoc\",\n)\n\n# ── CORS (allow React dev server) ──────────────\napp.add_middleware(\n    CORSMiddleware,\n    allow_origins=[\"http://localhost:5173\", \"http://localhost:3000\", \"*\"],\n    allow_credentials=True,\n    allow_methods=[\"*\"],\n    allow_headers=[\"*\"],\n)\n\n# ── Routers ────────────────────────────────────\napp.include_router(dashboard_router, prefix=\"/api/v1\")\napp.include_router(projects_router, prefix=\"/api/v1\")\napp.include_router(deps_router, prefix=\"/api/v1\")\napp.include_router(scans_router, prefix=\"/api/v1\")\napp.include_router(builds_router, prefix=\"/api/v1\")\n\n\n@app.get(\"/\", tags=[\"Health\"])\ndef root():\n    return {\n        \"service\": \"SecureChain\",\n        \"version\": \"1.0.0\",\n        \"status\": \"running\",\n        \"docs\": \"/docs\",\n    }\n\n\n@app.get(\"/health\", tags=[\"Health\"])\ndef health():\n    return {\"status\": \"healthy\"}\n\n\nif __name__ == \"__main__\":\n    import uvicorn\n    uvicorn.run(\"main:app\", host=\"0.0.0.0\", port=8000, reload=True)\n","Description":"FastAPI app entrypoint with lifespan events and all routers","Overwrite":false,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\backend\\main.py","toolAction":"Writing FastAPI main entrypoint","toolSummary":"Backend main.py"}}]}
