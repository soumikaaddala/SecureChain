{"step_index":67,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-08T04:48:36Z","content":"Now let's write the React components:","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { type Severity, type ThreatType, type ScanStatus, type RemediationStatus, type BuildStatus } from '../api/client'\n\nexport const SEVERITY_CONFIG: Record<Severity, { label: string; color: string; bg: string; ring: string }> = {\n  critical: { label: 'Critical', color: 'text-red-300', bg: 'bg-red-900/40', ring: 'ring-red-700' },\n  high:     { label: 'High',     color: 'text-orange-300', bg: 'bg-orange-900/40', ring: 'ring-orange-700' },\n  medium:   { label: 'Medium',   color: 'text-yellow-300', bg: 'bg-yellow-900/40', ring: 'ring-yellow-700' },\n  low:      { label: 'Low',      color: 'text-blue-300',   bg: 'bg-blue-900/40',   ring: 'ring-blue-700' },\n  none:     { label: 'None',     color: 'text-green-300',  bg: 'bg-green-900/40',  ring: 'ring-green-700' },\n  unknown:  { label: 'Unknown',  color: 'text-gray-300',   bg: 'bg-gray-800',      ring: 'ring-gray-700' },\n}\n\nexport const THREAT_LABELS: Record<ThreatType, string> = {\n  dependency_confusion: 'Dependency Confusion',\n  malicious_package: 'Malicious Package',\n  artifact_tampering: 'Artifact Tampering',\n  build_compromise: 'Build Compromise',\n  secret_leakage: 'Secret Leakage',\n  supply_chain_attack: 'Supply Chain Attack',\n  cve: 'CVE',\n  outdated: 'Outdated',\n  license_violation: 'License Violation',\n}\n\nexport const THREAT_COLORS: Record<ThreatType, string> = {\n  dependency_confusion: 'text-purple-300',\n  malicious_package: 'text-red-400',\n  artifact_tampering: 'text-orange-400',\n  build_compromise: 'text-red-300',\n  secret_leakage: 'text-pink-400',\n  supply_chain_attack: 'text-yellow-400',\n  cve: 'text-red-400',\n  outdated: 'text-gray-400',\n  license_violation: 'text-teal-400',\n}\n\nexport const SCAN_STATUS_CONFIG: Record<ScanStatus, { label: string; color: string; pulse?: boolean }> = {\n  pending:   { label: 'Pending',   color: 'text-gray-400' },\n  running:   { label: 'Running',   color: 'text-sky-400', pulse: true },\n  completed: { label: 'Completed', color: 'text-green-400' },\n  failed:    { label: 'Failed',    color: 'text-red-400' },\n}\n\nexport const REMEDIATION_STATUS_CONFIG: Record<RemediationStatus, { label: string; color: string }> = {\n  open:           { label: 'Open',           color: 'text-red-400' },\n  in_progress:    { label: 'In Progress',    color: 'text-yellow-400' },\n  resolved:       { label: 'Resolved',       color: 'text-green-400' },\n  wont_fix:       { label: \"Won't Fix\",      color: 'text-gray-500' },\n  false_positive: { label: 'False Positive', color: 'text-blue-400' },\n}\n\nexport const BUILD_STATUS_CONFIG: Record<BuildStatus, { label: string; color: string }> = {\n  success:   { label: 'Success',   color: 'text-green-400' },\n  failure:   { label: 'Failure',   color: 'text-red-400' },\n  running:   { label: 'Running',   color: 'text-sky-400' },\n  cancelled: { label: 'Cancelled', color: 'text-gray-400' },\n}\n\nexport const ECOSYSTEM_ICONS: Record<string, string> = {\n  npm: '📦',\n  pypi: '🐍',\n  maven: '☕',\n  nuget: '🔷',\n  rubygems: '💎',\n  go: '🐹',\n  cargo: '🦀',\n  docker: '🐳',\n  unknown: '📁',\n}\n\nexport function riskColor(score: number): string {\n  if (score >= 75) return 'text-red-400'\n  if (score >= 50) return 'text-orange-400'\n  if (score >= 25) return 'text-yellow-400'\n  return 'text-green-400'\n}\n\nexport function riskLabel(score: number): string {\n  if (score >= 75) return 'Critical'\n  if (score >= 50) return 'High'\n  if (score >= 25) return 'Medium'\n  return 'Low'\n}\n\nexport function formatDate(iso?: string): string {\n  if (!iso) return '—'\n  return new Date(iso).toLocaleDateString('en-US', {\n    month: 'short', day: 'numeric', year: 'numeric',\n    hour: '2-digit', minute: '2-digit',\n  })\n}\n\nexport function formatSize(bytes?: number): string {\n  if (!bytes) return '—'\n  if (bytes < 1024) return `${bytes} B`\n  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`\n  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`\n}\n","Description":"Shared constants and utility functions for the UI","Overwrite":false,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\lib\\constants.ts","toolAction":"Writing UI constants","toolSummary":"Frontend constants file"}}]}
