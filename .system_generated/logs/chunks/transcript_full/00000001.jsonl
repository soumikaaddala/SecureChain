{"step_index":75,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-08T04:50:03Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { useEffect, useState } from 'react'\nimport { Link } from 'react-router-dom'\nimport { Plus, Trash2, FolderGit2, ChevronRight, ExternalLink } from 'lucide-react'\nimport {\n  getProjects, createProject, deleteProject,\n  type Project\n} from '../api/client'\nimport {\n  PageHeader, Spinner, ErrorBanner, EmptyState, RiskScore\n} from '../components/ui'\nimport { ECOSYSTEM_ICONS, formatDate } from '../lib/constants'\nimport clsx from 'clsx'\n\nconst ECOSYSTEMS = ['unknown', 'npm', 'pypi', 'maven', 'nuget', 'rubygems', 'go', 'cargo', 'docker']\n\nexport default function Projects() {\n  const [projects, setProjects] = useState<Project[]>([])\n  const [loading, setLoading] = useState(true)\n  const [error, setError] = useState('')\n  const [showForm, setShowForm] = useState(false)\n  const [submitting, setSubmitting] = useState(false)\n  const [form, setForm] = useState({\n    name: '', description: '', repo_url: '', ecosystem: 'unknown',\n    owner: '', team: '', default_branch: 'main',\n  })\n\n  const load = () => {\n    setLoading(true)\n    getProjects()\n      .then(setProjects)\n      .catch(() => setError('Failed to load projects'))\n      .finally(() => setLoading(false))\n  }\n\n  useEffect(load, [])\n\n  const handleCreate = async (e: React.FormEvent) => {\n    e.preventDefault()\n    if (!form.name.trim()) return\n    setSubmitting(true)\n    try {\n      await createProject(form as Partial<Project>)\n      setShowForm(false)\n      setForm({ name: '', description: '', repo_url: '', ecosystem: 'unknown', owner: '', team: '', default_branch: 'main' })\n      load()\n    } catch {\n      setError('Failed to create project')\n    } finally {\n      setSubmitting(false)\n    }\n  }\n\n  const handleDelete = async (id: number, name: string) => {\n    if (!confirm(`Delete project \"${name}\"? This cannot be undone.`)) return\n    await deleteProject(id)\n    load()\n  }\n\n  return (\n    <div className=\"p-6\">\n      <PageHeader\n        title=\"Projects\"\n        subtitle={`${projects.length} registered project${projects.length !== 1 ? 's' : ''}`}\n        actions={\n          <button onClick={() => setShowForm(s => !s)} className=\"btn-primary\">\n            <Plus size={15} /> New Project\n          </button>\n        }\n      />\n\n      {error && <ErrorBanner message={error} />}\n\n      {/* Create Form */}\n      {showForm && (\n        <div className=\"card mb-6\">\n          <h3 className=\"text-sm font-semibold text-gray-200 mb-4\">Register New Project</h3>\n          <form onSubmit={handleCreate} className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n            <div className=\"md:col-span-2\">\n              <label className=\"block text-xs text-gray-400 mb-1\">Project Name *</label>\n              <input className=\"input\" placeholder=\"my-service\"\n                value={form.name} onChange={e => setForm(f => ({ ...f, name: e.target.value }))} required />\n            </div>\n            <div className=\"md:col-span-2\">\n              <label className=\"block text-xs text-gray-400 mb-1\">Description</label>\n              <input className=\"input\" placeholder=\"Brief project description\"\n                value={form.description} onChange={e => setForm(f => ({ ...f, description: e.target.value }))} />\n            </div>\n            <div>\n              <label className=\"block text-xs text-gray-400 mb-1\">Repository URL</label>\n              <input className=\"input\" placeholder=\"https://github.com/org/repo\"\n                value={form.repo_url} onChange={e => setForm(f => ({ ...f, repo_url: e.target.value }))} />\n            </div>\n            <div>\n              <label className=\"block text-xs text-gray-400 mb-1\">Ecosystem</label>\n              <select className=\"select\" value={form.ecosystem}\n                onChange={e => setForm(f => ({ ...f, ecosystem: e.target.value }))}>\n                {ECOSYSTEMS.map(e => (\n                  <option key={e} value={e}>\n                    {ECOSYSTEM_ICONS[e]} {e.toUpperCase()}\n                  </option>\n                ))}\n              </select>\n            </div>\n            <div>\n              <label className=\"block text-xs text-gray-400 mb-1\">Owner</label>\n              <input className=\"input\" placeholder=\"john.doe\"\n                value={form.owner} onChange={e => setForm(f => ({ ...f, owner: e.target.value }))} />\n            </div>\n            <div>\n              <label className=\"block text-xs text-gray-400 mb-1\">Team</label>\n              <input className=\"input\" placeholder=\"platform-security\"\n                value={form.team} onChange={e => setForm(f => ({ ...f, team: e.target.value }))} />\n            </div>\n            <div>\n              <label className=\"block text-xs text-gray-400 mb-1\">Default Branch</label>\n              <input className=\"input\" placeholder=\"main\"\n                value={form.default_branch} onChange={e => setForm(f => ({ ...f, default_branch: e.target.value }))} />\n            </div>\n            <div className=\"md:col-span-2 flex gap-2 justify-end pt-2\">\n              <button type=\"button\" className=\"btn-secondary\" onClick={() => setShowForm(false)}>Cancel</button>\n              <button type=\"submit\" className=\"btn-primary\" disabled={submitting}>\n                {submitting ? 'Creating…' : 'Create Project'}\n              </button>\n            </div>\n          </form>\n        </div>\n      )}\n\n      {loading ? <Spinner /> : projects.length === 0 ? (\n        <EmptyState\n          message=\"No projects yet. Click 'New Project' to register your first project.\"\n          icon={<FolderGit2 size={40} />}\n        />\n      ) : (\n        <div className=\"space-y-3\">\n          {projects.map(p => (\n            <div key={p.id} className=\"card hover:border-gray-700 transition-colors group\">\n              <div className=\"flex items-start justify-between gap-4\">\n                <div className=\"flex-1 min-w-0\">\n                  <div className=\"flex items-center gap-2 mb-1\">\n                    <span className=\"text-lg\">{ECOSYSTEM_ICONS[p.ecosystem]}</span>\n                    <Link\n                      to={`/projects/${p.id}`}\n                      className=\"text-sm font-semibold text-white hover:text-sky-400 transition-colors\"\n                    >\n                      {p.name}\n                    </Link>\n                    {!p.is_active && (\n                      <span className=\"badge bg-gray-800 text-gray-500 border border-gray-700 text-xs\">Inactive</span>\n                    )}\n                  </div>\n                  {p.description && (\n                    <p className=\"text-xs text-gray-400 mb-2 truncate\">{p.description}</p>\n                  )}\n                  <div className=\"flex flex-wrap gap-3 text-xs text-gray-500\">\n                    {p.owner && <span>👤 {p.owner}</span>}\n                    {p.team && <span>🏷️ {p.team}</span>}\n                    <span>📅 {formatDate(p.created_at)}</span>\n                    {p.repo_url && (\n                      <a href={p.repo_url} target=\"_blank\" rel=\"noreferrer\"\n                        className=\"inline-flex items-center gap-1 text-sky-500 hover:text-sky-400\">\n                        <ExternalLink size={11} /> Repo\n                      </a>\n                    )}\n                  </div>\n                </div>\n\n                {/* Stats */}\n                <div className=\"flex items-center gap-6 flex-shrink-0\">\n                  <div className=\"text-right\">\n                    <p className=\"text-xs text-gray-500\">Dependencies</p>\n                    <p className=\"text-base font-bold text-white\">{p.total_deps ?? 0}</p>\n                  </div>\n                  <div className=\"text-right\">\n                    <p className=\"text-xs text-gray-500\">Critical</p>\n                    <p className={clsx('text-base font-bold', (p.critical_findings ?? 0) > 0 ? 'text-red-400' : 'text-green-400')}>\n                      {p.critical_findings ?? 0}\n                    </p>\n                  </div>\n                  <RiskScore score={p.risk_score ?? 0} />\n                  <div className=\"flex items-center gap-1\">\n                    <Link to={`/projects/${p.id}`} className=\"btn-secondary text-xs py-1.5 px-3\">\n                      <ChevronRight size={13} />\n                    </Link>\n                    <button\n                      onClick={() => handleDelete(p.id, p.name)}\n                      className=\"p-2 rounded-lg text-gray-600 hover:text-red-400 hover:bg-red-900/20 transition-colors\"\n                    >\n                      <Trash2 size={13} />\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n    </div>\n  )\n}\n","Description":"Projects list and creation page","Overwrite":false,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\pages\\Projects.tsx","toolAction":"Writing Projects page","toolSummary":"Projects page component"}}]}
{"step_index":76,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-08T04:50:33Z","content":"Created At: 2026-10-08T10:20:33+05:30\nCompleted At: 2026-10-08T10:20:33+05:30\nCreated file file:///c:/Users/addal/Documents/antigravity/focused-bell/frontend/src/pages/Projects.tsx with requested content.\nIf relevant, proactively run terminal commands to execute this code for the USER. Don't ask for permission."}
{"step_index":77,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-08T04:50:33Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { useEffect, useState } from 'react'\nimport { useParams, Link, useNavigate } from 'react-router-dom'\nimport { ArrowLeft, Play, Package, FileText, Hammer, Database, AlertTriangle } from 'lucide-react'\nimport {\n  getProject, getScans, triggerScan, getDependencies, getBuilds, getArtifacts,\n  type Project, type Scan, type Dependency, type Build, type Artifact\n} from '../api/client'\nimport {\n  Spinner, ErrorBanner, ScanStatusBadge, SeverityBadge, RiskScore, PageHeader\n} from '../components/ui'\nimport { formatDate, ECOSYSTEM_ICONS } from '../lib/constants'\nimport clsx from 'clsx'\n\ntype Tab = 'overview' | 'dependencies' | 'scans' | 'builds' | 'artifacts'\n\nexport default function ProjectDetail() {\n  const { id } = useParams<{ id: string }>()\n  const projectId = Number(id)\n  const navigate = useNavigate()\n\n  const [project, setProject] = useState<Project | null>(null)\n  const [scans, setScans] = useState<Scan[]>([])\n  const [deps, setDeps] = useState<Dependency[]>([])\n  const [builds, setBuilds] = useState<Build[]>([])\n  const [artifacts, setArtifacts] = useState<Artifact[]>([])\n  const [tab, setTab] = useState<Tab>('overview')\n  const [loading, setLoading] = useState(true)\n  const [scanning, setScanning] = useState(false)\n  const [error, setError] = useState('')\n\n  const loadAll = async () => {\n    try {\n      const [p, s, d, b, a] = await Promise.all([\n        getProject(projectId),\n        getScans(projectId),\n        getDependencies(projectId),\n        getBuilds(projectId),\n        getArtifacts(projectId),\n      ])\n      setProject(p); setScans(s); setDeps(d); setBuilds(b); setArtifacts(a)\n    } catch {\n      setError('Failed to load project data')\n    } finally {\n      setLoading(false)\n    }\n  }\n\n  useEffect(() => { loadAll() }, [projectId])\n\n  const handleScan = async () => {\n    setScanning(true)\n    try {\n      await triggerScan(projectId, { scan_type: 'full', triggered_by: 'manual' })\n      // Poll until completed\n      setTimeout(async () => {\n        const updated = await getScans(projectId)\n        setScans(updated)\n        setScanning(false)\n        const p = await getProject(projectId)\n        setProject(p)\n      }, 3000)\n    } catch {\n      setError('Scan failed to start')\n      setScanning(false)\n    }\n  }\n\n  if (loading) return <Spinner />\n  if (!project) return <ErrorBanner message=\"Project not found\" />\n\n  const latestScan = scans[0]\n  const TABS: { key: Tab; label: string; count?: number }[] = [\n    { key: 'overview',     label: 'Overview' },\n    { key: 'dependencies', label: 'Dependencies', count: deps.length },\n    { key: 'scans',        label: 'Scans', count: scans.length },\n    { key: 'builds',       label: 'Builds', count: builds.length },\n    { key: 'artifacts',    label: 'Artifacts', count: artifacts.length },\n  ]\n\n  return (\n    <div className=\"p-6\">\n      {/* Header */}\n      <div className=\"flex items-start gap-4 mb-6\">\n        <button onClick={() => navigate('/projects')}\n          className=\"p-2 rounded-lg text-gray-500 hover:text-gray-300 hover:bg-gray-800 transition-colors mt-0.5\">\n          <ArrowLeft size={16} />\n        </button>\n        <div className=\"flex-1\">\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"text-xl\">{ECOSYSTEM_ICONS[project.ecosystem]}</span>\n            <h1 className=\"text-xl font-bold text-white\">{project.name}</h1>\n          </div>\n          {project.description && (\n            <p className=\"text-sm text-gray-400\">{project.description}</p>\n          )}\n          <div className=\"flex flex-wrap gap-3 text-xs text-gray-500 mt-2\">\n            {project.owner && <span>👤 {project.owner}</span>}\n            {project.team && <span>🏷️ {project.team}</span>}\n            <span>Branch: {project.default_branch}</span>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          {project.risk_score !== undefined && <RiskScore score={project.risk_score} />}\n          <button\n            onClick={handleScan}\n            disabled={scanning}\n            className=\"btn-primary\"\n          >\n            {scanning ? (\n              <><span className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" /> Scanning…</>\n            ) : (\n              <><Play size={14} /> Run Scan</>\n            )}\n          </button>\n        </div>\n      </div>\n\n      {error && <ErrorBanner message={error} />}\n\n      {/* Tabs */}\n      <div className=\"flex gap-1 border-b border-gray-800 mb-6\">\n        {TABS.map(t => (\n          <button\n            key={t.key}\n            onClick={() => setTab(t.key)}\n            className={clsx(\n              'px-4 py-2 text-sm font-medium border-b-2 transition-colors -mb-px',\n              tab === t.key\n                ? 'border-sky-500 text-sky-400'\n                : 'border-transparent text-gray-500 hover:text-gray-300'\n            )}\n          >\n            {t.label}\n            {t.count !== undefined && (\n              <span className=\"ml-1.5 text-xs bg-gray-800 text-gray-400 px-1.5 py-0.5 rounded-full\">\n                {t.count}\n              </span>\n            )}\n          </button>\n        ))}\n      </div>\n\n      {/* Tab Content */}\n      {tab === 'overview' && (\n        <div className=\"space-y-4\">\n          {/* Latest scan summary */}\n          {latestScan ? (\n            <div className=\"card\">\n              <div className=\"flex items-center justify-between mb-4\">\n                <h3 className=\"text-sm font-semibold text-gray-200\">Latest Scan #{latestScan.id}</h3>\n                <ScanStatusBadge status={latestScan.status} />\n              </div>\n              <div className=\"grid grid-cols-2 md:grid-cols-5 gap-4\">\n                {[\n                  { label: 'Critical', value: latestScan.critical_count, color: 'text-red-400' },\n                  { label: 'High', value: latestScan.high_count, color: 'text-orange-400' },\n                  { label: 'Medium', value: latestScan.medium_count, color: 'text-yellow-400' },\n                  { label: 'Low', value: latestScan.low_count, color: 'text-blue-400' },\n                  { label: 'Deps Scanned', value: latestScan.total_deps_scanned, color: 'text-gray-300' },\n                ].map(item => (\n                  <div key={item.label} className=\"text-center\">\n                    <p className={clsx('text-2xl font-bold', item.color)}>{item.value}</p>\n                    <p className=\"text-xs text-gray-500\">{item.label}</p>\n                  </div>\n                ))}\n              </div>\n              {latestScan.status === 'completed' && (\n                <div className=\"mt-4 flex gap-2\">\n                  <Link to={`/projects/${projectId}/report`} className=\"btn-secondary text-xs\">\n                    <FileText size={13} /> View Report\n                  </Link>\n                  <Link\n                    to={`/scans?project=${projectId}&scan=${latestScan.id}`}\n                    className=\"btn-secondary text-xs\"\n                  >\n                    <AlertTriangle size={13} /> View Findings\n                  </Link>\n                </div>\n              )}\n            </div>\n          ) : (\n            <div className=\"card text-center py-10\">\n              <p className=\"text-gray-500 text-sm mb-3\">No scans yet for this project.</p>\n              <button onClick={handleScan} className=\"btn-primary mx-auto\">\n                <Play size={14} /> Run First Scan\n              </button>\n            </div>\n          )}\n\n          {/* Quick stats */}\n          <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n            {[\n              { icon: <Package size={18} className=\"text-purple-400\" />, label: 'Dependencies', value: deps.length },\n              { icon: <Hammer size={18} className=\"text-sky-400\" />, label: 'Builds', value: builds.length },\n              { icon: <Database size={18} className=\"text-green-400\" />, label: 'Artifacts', value: artifacts.length },\n              { icon: <AlertTriangle size={18} className=\"text-yellow-400\" />, label: 'Scans', value: scans.length },\n            ].map(item => (\n              <div key={item.label} className=\"card flex items-center gap-3\">\n                <div className=\"w-9 h-9 rounded-lg bg-gray-800 flex items-center justify-center\">\n                  {item.icon}\n                </div>\n                <div>\n                  <p className=\"text-xs text-gray-500\">{item.label}</p>\n                  <p className=\"text-lg font-bold text-white\">{item.value}</p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {tab === 'dependencies' && (\n        <DepsTab deps={deps} projectId={projectId} onRefresh={loadAll} />\n      )}\n\n      {tab === 'scans' && (\n        <div className=\"space-y-2\">\n          {scans.length === 0 ? (\n            <p className=\"text-gray-500 text-sm text-center py-10\">No scans yet</p>\n          ) : (\n            scans.map(scan => (\n              <div key={scan.id} className=\"card flex items-center justify-between gap-4\">\n                <div className=\"flex items-center gap-3\">\n                  <ScanStatusBadge status={scan.status} />\n                  <div>\n                    <p className=\"text-sm font-medium text-gray-200\">Scan #{scan.id}</p>\n                    <p className=\"text-xs text-gray-500\">{formatDate(scan.started_at)}</p>\n                  </div>\n                </div>\n                <div className=\"flex gap-4 text-sm\">\n                  <span className=\"text-red-400\">{scan.critical_count} critical</span>\n                  <span className=\"text-orange-400\">{scan.high_count} high</span>\n                  <span className=\"text-gray-400\">Risk: {scan.risk_score.toFixed(1)}</span>\n                </div>\n                {scan.status === 'completed' && (\n                  <Link\n                    to={`/scans?project=${projectId}&scan=${scan.id}`}\n                    className=\"btn-secondary text-xs\"\n                  >\n                    View Findings\n                  </Link>\n                )}\n              </div>\n            ))\n          )}\n        </div>\n      )}\n\n      {tab === 'builds' && (\n        <BuildsTab builds={builds} />\n      )}\n\n      {tab === 'artifacts' && (\n        <ArtifactsTab artifacts={artifacts} />\n      )}\n    </div>\n  )\n}\n\n// ── Sub-components ────────────────────────────────\n\nfunction DepsTab({ deps, projectId, onRefresh }: { deps: Dependency[]; projectId: number; onRefresh: () => void }) {\n  const [showAdd, setShowAdd] = useState(false)\n  const [form, setForm] = useState({ name: '', version: '', ecosystem: 'npm', is_direct: true, is_dev: false, license: '' })\n  const { addDependency } = require('../api/client')\n\n  const handle = async (e: React.FormEvent) => {\n    e.preventDefault()\n    await addDependency(projectId, form)\n    setShowAdd(false)\n    onRefresh()\n  }\n\n  return (\n    <div>\n      <div className=\"flex justify-end mb-3\">\n        <button onClick={() => setShowAdd(s => !s)} className=\"btn-secondary text-xs\">\n          <Package size={13} /> Add Dependency\n        </button>\n      </div>\n      {showAdd && (\n        <div className=\"card mb-4\">\n          <form onSubmit={handle} className=\"grid grid-cols-2 md:grid-cols-4 gap-3\">\n            <div>\n              <label className=\"text-xs text-gray-400 block mb-1\">Name</label>\n              <input className=\"input\" placeholder=\"lodash\" required\n                value={form.name} onChange={e => setForm(f => ({ ...f, name: e.target.value }))} />\n            </div>\n            <div>\n              <label className=\"text-xs text-gray-400 block mb-1\">Version</label>\n              <input className=\"input\" placeholder=\"4.17.21\" required\n                value={form.version} onChange={e => setForm(f => ({ ...f, version: e.target.value }))} />\n            </div>\n            <div>\n              <label className=\"text-xs text-gray-400 block mb-1\">Ecosystem</label>\n              <select className=\"select\" value={form.ecosystem}\n                onChange={e => setForm(f => ({ ...f, ecosystem: e.target.value }))}>\n                {['npm','pypi','maven','nuget','go','cargo','docker'].map(e => (\n                  <option key={e} value={e}>{ECOSYSTEM_ICONS[e]} {e}</option>\n                ))}\n              </select>\n            </div>\n            <div>\n              <label className=\"text-xs text-gray-400 block mb-1\">License</label>\n              <input className=\"input\" placeholder=\"MIT\"\n                value={form.license} onChange={e => setForm(f => ({ ...f, license: e.target.value }))} />\n            </div>\n            <div className=\"flex items-center gap-4 col-span-2\">\n              <label className=\"flex items-center gap-2 text-xs text-gray-400 cursor-pointer\">\n                <input type=\"checkbox\" checked={form.is_direct}\n                  onChange={e => setForm(f => ({ ...f, is_direct: e.target.checked }))}\n                  className=\"rounded bg-gray-700 border-gray-600\" />\n                Direct dependency\n              </label>\n              <label className=\"flex items-center gap-2 text-xs text-gray-400 cursor-pointer\">\n                <input type=\"checkbox\" checked={form.is_dev}\n                  onChange={e => setForm(f => ({ ...f, is_dev: e.target.checked }))}\n                  className=\"rounded bg-gray-700 border-gray-600\" />\n                Dev dependency\n              </label>\n            </div>\n            <div className=\"col-span-2 flex gap-2 justify-end\">\n              <button type=\"button\" className=\"btn-secondary text-xs\" onClick={() => setShowAdd(false)}>Cancel</button>\n              <button type=\"submit\" className=\"btn-primary text-xs\">Add</button>\n            </div>\n          </form>\n        </div>\n      )}\n      {deps.length === 0 ? (\n        <p className=\"text-gray-500 text-sm text-center py-10\">No dependencies recorded</p>\n      ) : (\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-sm\">\n            <thead>\n              <tr className=\"border-b border-gray-800\">\n                <th className=\"text-left py-2 px-3 text-xs text-gray-500 font-medium\">Package</th>\n                <th className=\"text-left py-2 px-3 text-xs text-gray-500 font-medium\">Version</th>\n                <th className=\"text-left py-2 px-3 text-xs text-gray-500 font-medium\">Ecosystem</th>\n                <th className=\"text-left py-2 px-3 text-xs text-gray-500 font-medium\">Type</th>\n                <th className=\"text-left py-2 px-3 text-xs text-gray-500 font-medium\">License</th>\n                <th className=\"text-left py-2 px-3 text-xs text-gray-500 font-medium\">Hash</th>\n              </tr>\n            </thead>\n            <tbody>\n              {deps.map(d => (\n                <tr key={d.id} className=\"table-row\">\n                  <td className=\"py-2 px-3 font-mono text-xs text-sky-400\">{d.name}</td>\n                  <td className=\"py-2 px-3 text-xs text-gray-300\">{d.version}</td>\n                  <td className=\"py-2 px-3 text-xs\">\n                    {ECOSYSTEM_ICONS[d.ecosystem]} {d.ecosystem}\n                  </td>\n                  <td className=\"py-2 px-3 text-xs text-gray-400\">\n                    {d.is_direct ? '📍 Direct' : `↗ Trans. (d${d.depth})`}\n                    {d.is_dev && <span className=\"ml-1 text-gray-600\">[dev]</span>}\n                  </td>\n                  <td className=\"py-2 px-3 text-xs text-gray-400\">{d.license || '—'}</td>\n                  <td className=\"py-2 px-3\">\n                    {d.package_hash ? (\n                      <span className=\"font-mono text-xs text-green-500\" title={d.package_hash}>\n                        ✓ {d.package_hash.slice(0, 8)}…\n                      </span>\n                    ) : (\n                      <span className=\"text-xs text-yellow-600\">⚠ No hash</span>\n                    )}\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n    </div>\n  )\n}\n\nfunction BuildsTab({ builds }: { builds: Build[] }) {\n  if (builds.length === 0) return <p className=\"text-gray-500 text-sm text-center py-10\">No builds recorded</p>\n  return (\n    <div className=\"space-y-2\">\n      {builds.map(b => (\n        <div key={b.id} className=\"card flex items-center justify-between gap-4\">\n          <div>\n            <p className=\"text-sm font-medium text-gray-200\">Build #{b.build_number}</p>\n            <p className=\"text-xs text-gray-500\">\n              {b.branch} · {b.commit_sha?.slice(0, 7) || '—'} · {formatDate(b.started_at)}\n            </p>\n          </div>\n          <div className=\"flex items-center gap-4 text-xs\">\n            {b.secrets_detected && <span className=\"text-pink-400\">🔑 Secrets</span>}\n            {b.tampered && <span className=\"text-red-400\">⚠ Tampered</span>}\n            {!b.provenance && <span className=\"text-yellow-600\">No Provenance</span>}\n            <span className={clsx(\n              b.status === 'success' ? 'text-green-400' :\n              b.status === 'failure' ? 'text-red-400' :\n              b.status === 'running' ? 'text-sky-400' : 'text-gray-400'\n            )}>\n              {b.status.toUpperCase()}\n            </span>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n\nfunction ArtifactsTab({ artifacts }: { artifacts: Artifact[] }) {\n  if (artifacts.length === 0) return <p className=\"text-gray-500 text-sm text-center py-10\">No artifacts recorded</p>\n  return (\n    <div className=\"overflow-x-auto\">\n      <table className=\"w-full text-sm\">\n        <thead>\n          <tr className=\"border-b border-gray-800\">\n            <th className=\"text-left py-2 px-3 text-xs text-gray-500\">Name</th>\n            <th className=\"text-left py-2 px-3 text-xs text-gray-500\">Version</th>\n            <th className=\"text-left py-2 px-3 text-xs text-gray-500\">Type</th>\n            <th className=\"text-left py-2 px-3 text-xs text-gray-500\">SHA-256</th>\n            <th className=\"text-left py-2 px-3 text-xs text-gray-500\">Signed</th>\n            <th className=\"text-left py-2 px-3 text-xs text-gray-500\">Status</th>\n          </tr>\n        </thead>\n        <tbody>\n          {artifacts.map(a => (\n            <tr key={a.id} className=\"table-row\">\n              <td className=\"py-2 px-3 font-mono text-xs text-gray-300\">{a.name}</td>\n              <td className=\"py-2 px-3 text-xs text-gray-400\">{a.version || '—'}</td>\n              <td className=\"py-2 px-3 text-xs text-gray-400\">{a.artifact_type || '—'}</td>\n              <td className=\"py-2 px-3\">\n                {a.sha256 ? (\n                  <span className=\"font-mono text-xs text-green-500\" title={a.sha256}>\n                    ✓ {a.sha256.slice(0, 12)}…\n                  </span>\n                ) : (\n                  <span className=\"text-xs text-yellow-600\">⚠ Missing</span>\n                )}\n              </td>\n              <td className=\"py-2 px-3 text-xs\">\n                {a.is_signed ? <span className=\"text-green-400\">✓ Signed</span> : <span className=\"text-gray-600\">Unsigned</span>}\n              </td>\n              <td className=\"py-2 px-3 text-xs\">\n                {a.tampered ? (\n                  <span className=\"text-red-400 font-semibold\">⚠ TAMPERED</span>\n                ) : (\n                  <span className=\"text-green-500\">Clean</span>\n                )}\n              </td>\n            </tr>\n          ))}\n        </tbody>\n      </table>\n    </div>\n  )\n}\n","Description":"Project detail page with tabbed view for deps, scans, builds, and artifacts","Overwrite":false,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\pages\\ProjectDetail.tsx","toolAction":"Writing ProjectDetail page","toolSummary":"Project detail component"}}]}
