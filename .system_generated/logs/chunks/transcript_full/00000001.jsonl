{"step_index":71,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-08T04:49:07Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { type Severity, type ThreatType, type ScanStatus } from '../api/client'\nimport { SEVERITY_CONFIG, THREAT_LABELS, SCAN_STATUS_CONFIG } from '../lib/constants'\nimport clsx from 'clsx'\n\nexport function SeverityBadge({ severity }: { severity: Severity }) {\n  const cfg = SEVERITY_CONFIG[severity] || SEVERITY_CONFIG.unknown\n  return (\n    <span className={clsx('badge font-semibold text-xs uppercase tracking-wide', cfg.bg, cfg.color)}>\n      {cfg.label}\n    </span>\n  )\n}\n\nexport function ThreatBadge({ type }: { type: ThreatType }) {\n  const label = THREAT_LABELS[type] || type\n  return (\n    <span className=\"badge bg-gray-800 text-gray-300 border border-gray-700 text-xs\">\n      {label}\n    </span>\n  )\n}\n\nexport function ScanStatusBadge({ status }: { status: ScanStatus }) {\n  const cfg = SCAN_STATUS_CONFIG[status]\n  return (\n    <span className={clsx('inline-flex items-center gap-1.5 text-xs font-medium', cfg.color)}>\n      {cfg.pulse ? (\n        <span className=\"relative flex h-2 w-2\">\n          <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75\" />\n          <span className=\"relative inline-flex rounded-full h-2 w-2 bg-sky-500\" />\n        </span>\n      ) : (\n        <span className=\"w-2 h-2 rounded-full bg-current\" />\n      )}\n      {cfg.label}\n    </span>\n  )\n}\n\nexport function RiskScore({ score }: { score: number }) {\n  const color =\n    score >= 75 ? 'text-red-400'\n    : score >= 50 ? 'text-orange-400'\n    : score >= 25 ? 'text-yellow-400'\n    : 'text-green-400'\n  const ring =\n    score >= 75 ? 'stroke-red-500'\n    : score >= 50 ? 'stroke-orange-500'\n    : score >= 25 ? 'stroke-yellow-500'\n    : 'stroke-green-500'\n\n  const r = 20\n  const circ = 2 * Math.PI * r\n  const dash = circ * (score / 100)\n\n  return (\n    <div className=\"flex items-center gap-3\">\n      <svg width=\"52\" height=\"52\" viewBox=\"0 0 52 52\">\n        <circle cx=\"26\" cy=\"26\" r={r} fill=\"none\" stroke=\"#1f2937\" strokeWidth=\"5\" />\n        <circle\n          cx=\"26\" cy=\"26\" r={r}\n          fill=\"none\"\n          className={ring}\n          strokeWidth=\"5\"\n          strokeDasharray={`${dash} ${circ}`}\n          strokeLinecap=\"round\"\n          transform=\"rotate(-90 26 26)\"\n        />\n        <text x=\"26\" y=\"30\" textAnchor=\"middle\" className={clsx('text-xs font-bold fill-current', color)} fontSize=\"10\">\n          {score.toFixed(0)}\n        </text>\n      </svg>\n      <div>\n        <div className={clsx('font-bold text-lg', color)}>{score.toFixed(1)}</div>\n        <div className=\"text-xs text-gray-500\">Risk Score</div>\n      </div>\n    </div>\n  )\n}\n\nexport function StatCard({\n  label,\n  value,\n  sub,\n  icon,\n  color = 'text-gray-100',\n}: {\n  label: string\n  value: string | number\n  sub?: string\n  icon?: React.ReactNode\n  color?: string\n}) {\n  return (\n    <div className=\"card flex items-start justify-between gap-4\">\n      <div className=\"flex-1\">\n        <p className=\"text-xs text-gray-500 uppercase tracking-wide mb-1\">{label}</p>\n        <p className={clsx('text-3xl font-bold', color)}>{value}</p>\n        {sub && <p className=\"text-xs text-gray-500 mt-1\">{sub}</p>}\n      </div>\n      {icon && (\n        <div className=\"w-10 h-10 rounded-lg bg-gray-800 flex items-center justify-center flex-shrink-0\">\n          {icon}\n        </div>\n      )}\n    </div>\n  )\n}\n\nexport function EmptyState({ message, icon }: { message: string; icon?: React.ReactNode }) {\n  return (\n    <div className=\"flex flex-col items-center justify-center py-16 text-center\">\n      {icon && <div className=\"mb-3 text-gray-600\">{icon}</div>}\n      <p className=\"text-gray-500 text-sm\">{message}</p>\n    </div>\n  )\n}\n\nexport function Spinner() {\n  return (\n    <div className=\"flex items-center justify-center py-16\">\n      <div className=\"w-8 h-8 border-2 border-gray-700 border-t-sky-500 rounded-full animate-spin\" />\n    </div>\n  )\n}\n\nexport function PageHeader({\n  title,\n  subtitle,\n  actions,\n}: {\n  title: string\n  subtitle?: string\n  actions?: React.ReactNode\n}) {\n  return (\n    <div className=\"flex items-start justify-between mb-6\">\n      <div>\n        <h1 className=\"text-xl font-bold text-white\">{title}</h1>\n        {subtitle && <p className=\"text-sm text-gray-400 mt-0.5\">{subtitle}</p>}\n      </div>\n      {actions && <div className=\"flex items-center gap-2 flex-shrink-0\">{actions}</div>}\n    </div>\n  )\n}\n\nexport function ErrorBanner({ message }: { message: string }) {\n  return (\n    <div className=\"bg-red-900/30 border border-red-800 rounded-lg px-4 py-3 text-sm text-red-300 mb-4\">\n      ⚠️ {message}\n    </div>\n  )\n}\n","Description":"Shared UI components (badges, stat cards, spinners etc.)","Overwrite":false,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\components\\ui.tsx","toolAction":"Writing shared UI components","toolSummary":"Shared UI components"}}]}
