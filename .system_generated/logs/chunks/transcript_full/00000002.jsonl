{"step_index":95,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-08T05:02:23Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { useEffect, useState } from 'react'\nimport { AlertTriangle, ExternalLink } from 'lucide-react'\nimport { getProjects, getScans, getFindings, createRemediation, type Project, type Finding } from '../api/client'\nimport { PageHeader, Spinner, ErrorBanner, SeverityBadge, ThreatBadge } from '../components/ui'\nimport { THREAT_LABELS } from '../lib/constants'\nimport clsx from 'clsx'\n\nexport default function FindingsPage() {\n  const [projects, setProjects] = useState<Project[]>([])\n  const [selectedProjectId, setSelectedProjectId] = useState<string>('')\n  const [findings, setFindings] = useState<Finding[]>([])\n  const [loading, setLoading] = useState(false)\n  const [error, setError] = useState('')\n  const [activeModalFinding, setActiveModalFinding] = useState<Finding | null>(null)\n  const [remAction, setRemAction] = useState('')\n  const [remTargetVer, setRemTargetVer] = useState('')\n  const [submitting, setSubmitting] = useState(false)\n\n  useEffect(() => {\n    getProjects().then(projs => {\n      setProjects(projs)\n      if (projs.length > 0) setSelectedProjectId(String(projs[0].id))\n    }).catch(() => setError('Failed to load projects'))\n  }, [])\n\n  useEffect(() => {\n    if (!selectedProjectId) return\n    setLoading(true)\n    getScans(Number(selectedProjectId)).then(scans => {\n      if (scans.length === 0) {\n        setFindings([])\n        setLoading(false)\n        return\n      }\n      const latestScan = scans[0]\n      getFindings(Number(selectedProjectId), latestScan.id)\n        .then(setFindings)\n        .catch(() => setError('Failed to load findings'))\n        .finally(() => setLoading(false))\n    }).catch(() => {\n      setError('Failed to load project scans')\n      setLoading(false)\n    })\n  }, [selectedProjectId])\n\n  const handleCreateRemediation = async (e: React.FormEvent) => {\n    e.preventDefault()\n    if (!activeModalFinding) return\n    setSubmitting(true)\n    try {\n      await createRemediation(activeModalFinding.id, {\n        action: remAction || `Upgrade ${activeModalFinding.affected_package} to ${remTargetVer || 'safe version'}`,\n        target_version: remTargetVer || activeModalFinding.fixed_in_version || 'latest',\n        status: 'open',\n        priority: activeModalFinding.severity === 'critical' ? 1 : activeModalFinding.severity === 'high' ? 2 : 3,\n      })\n      setActiveModalFinding(null)\n      setRemAction('')\n      setRemTargetVer('')\n      alert('Remediation task created successfully!')\n    } catch {\n      setError('Failed to create remediation task')\n    } finally {\n      setSubmitting(false)\n    }\n  }\n\n  return (\n    <div className=\"p-6\">\n      <PageHeader\n        title=\"Vulnerability Findings\"\n        subtitle=\"Security findings identified across latest scans\"\n      />\n\n      {error && <ErrorBanner message={error} />}\n\n      <div className=\"card mb-6\">\n        <div className=\"w-64\">\n          <label className=\"text-xs text-gray-400 block mb-1\">Select Project</label>\n          <select\n            className=\"select\"\n            value={selectedProjectId}\n            onChange={e => setSelectedProjectId(e.target.value)}\n          >\n            <option value=\"\">Select Project</option>\n            {projects.map(p => (\n              <option key={p.id} value={p.id}>{p.name}</option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      {loading ? (\n        <Spinner />\n      ) : findings.length === 0 ? (\n        <div className=\"card text-center py-12\">\n          <AlertTriangle size={36} className=\"text-gray-700 mx-auto mb-3\" />\n          <p className=\"text-gray-500\">No vulnerability findings detected for this project's latest scan.</p>\n        </div>\n      ) : (\n        <div className=\"space-y-3\">\n          {findings.map(f => (\n            <div key={f.id} className=\"card hover:border-gray-700 transition-colors\">\n              <div className=\"flex items-start justify-between gap-4\">\n                <div className=\"space-y-2 flex-1\">\n                  <div className=\"flex items-center gap-2 flex-wrap\">\n                    <SeverityBadge severity={f.severity} />\n                    <ThreatBadge type={f.threat_type} />\n                    <span className=\"text-sm font-semibold text-white\">{f.title}</span>\n                  </div>\n                  <p className=\"text-xs text-gray-400\">{f.description}</p>\n                  <div className=\"flex flex-wrap gap-4 text-xs text-gray-500\">\n                    <span>Package: <strong className=\"text-sky-400 font-mono\">{f.affected_package}</strong></span>\n                    {f.affected_version && <span>Version: <strong className=\"text-gray-300 font-mono\">{f.affected_version}</strong></span>}\n                    {f.fixed_in_version && <span className=\"text-green-400 font-semibold\">Fixed in: {f.fixed_in_version}</span>}\n                    {f.cve_id && (\n                      <a href={`https://nvd.nist.gov/vuln/detail/${f.cve_id}`} target=\"_blank\" rel=\"noreferrer\" className=\"text-sky-500 hover:underline inline-flex items-center gap-1\">\n                        {f.cve_id} <ExternalLink size={10} />\n                      </a>\n                    )}\n                  </div>\n                </div>\n                <div className=\"flex flex-col items-end gap-2\">\n                  {f.cvss_score !== undefined && f.cvss_score !== null && (\n                    <span className={clsx('text-base font-bold font-mono', f.cvss_score >= 7 ? 'text-red-400' : 'text-yellow-400')}>\n                      CVSS {f.cvss_score.toFixed(1)}\n                    </span>\n                  )}\n                  <button\n                    onClick={() => setActiveModalFinding(f)}\n                    className=\"btn-primary text-xs py-1.5 px-3\"\n                  >\n                    Track Remediation\n                  </button>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* Remediation Modal */}\n      {activeModalFinding && (\n        <div className=\"fixed inset-0 bg-black/70 flex items-center justify-center p-4 z-50\">\n          <div className=\"card w-full max-w-md bg-gray-900 border-gray-700\">\n            <h3 className=\"text-base font-bold text-white mb-2\">Create Remediation Task</h3>\n            <p className=\"text-xs text-gray-400 mb-4\">{activeModalFinding.title}</p>\n            <form onSubmit={handleCreateRemediation} className=\"space-y-3\">\n              <div>\n                <label className=\"text-xs text-gray-400 block mb-1\">Action Description</label>\n                <input\n                  className=\"input text-xs\"\n                  placeholder={`e.g. Upgrade ${activeModalFinding.affected_package} to secure version`}\n                  value={remAction}\n                  onChange={e => setRemAction(e.target.value)}\n                />\n              </div>\n              <div>\n                <label className=\"text-xs text-gray-400 block mb-1\">Target Version</label>\n                <input\n                  className=\"input text-xs font-mono\"\n                  placeholder={activeModalFinding.fixed_in_version || 'e.g. 2.0.0'}\n                  value={remTargetVer}\n                  onChange={e => setRemTargetVer(e.target.value)}\n                />\n              </div>\n              <div className=\"flex gap-2 justify-end pt-3\">\n                <button type=\"button\" className=\"btn-secondary text-xs\" onClick={() => setActiveModalFinding(null)}>\n                  Cancel\n                </button>\n                <button type=\"submit\" className=\"btn-primary text-xs\" disabled={submitting}>\n                  {submitting ? 'Creating...' : 'Save Remediation'}\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n","Description":"Findings list and remediation tracking trigger page","Overwrite":false,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\pages\\Findings.tsx","toolAction":"Writing Findings page","toolSummary":"Findings page component"}}]}
