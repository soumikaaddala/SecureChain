{"step_index":103,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-08T05:03:44Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { useEffect, useState } from 'react'\nimport { Shield, Plus } from 'lucide-react'\nimport { getThreatIntel, addThreatIntel, type ThreatIntel } from '../api/client'\nimport { PageHeader, Spinner, ErrorBanner, SeverityBadge, ThreatBadge } from '../components/ui'\nimport { ECOSYSTEM_ICONS } from '../lib/constants'\n\nexport default function ThreatIntelPage() {\n  const [intelList, setIntelList] = useState<ThreatIntel[]>([])\n  const [loading, setLoading] = useState(true)\n  const [error, setError] = useState('')\n  const [showAddModal, setShowAddModal] = useState(false)\n  const [form, setForm] = useState({\n    package_name: '',\n    ecosystem: 'npm',\n    threat_type: 'malicious_package',\n    severity: 'high',\n    cve_id: '',\n    description: '',\n    source: 'custom-feed'\n  })\n\n  const loadIntel = () => {\n    setLoading(true)\n    getThreatIntel()\n      .then(setIntelList)\n      .catch(() => setError('Failed to load threat intel feed'))\n      .finally(() => setLoading(false))\n  }\n\n  useEffect(loadIntel, [])\n\n  const handleCreate = async (e: React.FormEvent) => {\n    e.preventDefault()\n    try {\n      await addThreatIntel(form as any)\n      setShowAddModal(false)\n      setForm({ package_name: '', ecosystem: 'npm', threat_type: 'malicious_package', severity: 'high', cve_id: '', description: '', source: 'custom-feed' })\n      loadIntel()\n    } catch {\n      setError('Failed to add threat intel entry')\n    }\n  }\n\n  return (\n    <div className=\"p-6\">\n      <PageHeader\n        title=\"Threat Intelligence Feed\"\n        subtitle=\"Known malicious packages, dependency confusion signatures, and CVE database\"\n        actions={\n          <button onClick={() => setShowAddModal(true)} className=\"btn-primary\">\n            <Plus size={15} /> Add Threat Intel Entry\n          </button>\n        }\n      />\n\n      {error && <ErrorBanner message={error} />}\n\n      {loading ? (\n        <Spinner />\n      ) : intelList.length === 0 ? (\n        <div className=\"card text-center py-12\">\n          <Shield size={36} className=\"text-gray-700 mx-auto mb-3\" />\n          <p className=\"text-gray-500\">No threat intel signatures registered.</p>\n        </div>\n      ) : (\n        <div className=\"card overflow-hidden p-0\">\n          <table className=\"w-full text-sm\">\n            <thead>\n              <tr className=\"border-b border-gray-800\">\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Severity</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Threat Type</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Package Name</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Ecosystem</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">CVE / Ref</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Description</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Source</th>\n              </tr>\n            </thead>\n            <tbody>\n              {intelList.map(item => (\n                <tr key={item.id} className=\"table-row\">\n                  <td className=\"py-2.5 px-4\"><SeverityBadge severity={item.severity} /></td>\n                  <td className=\"py-2.5 px-4\"><ThreatBadge type={item.threat_type} /></td>\n                  <td className=\"py-2.5 px-4 font-mono text-xs font-semibold text-red-400\">{item.package_name}</td>\n                  <td className=\"py-2.5 px-4 text-xs\">{ECOSYSTEM_ICONS[item.ecosystem]} {item.ecosystem}</td>\n                  <td className=\"py-2.5 px-4 text-xs text-gray-400\">{item.cve_id || '—'}</td>\n                  <td className=\"py-2.5 px-4 text-xs text-gray-300 max-w-xs truncate\">{item.description || '—'}</td>\n                  <td className=\"py-2.5 px-4 text-xs text-gray-500\">{item.source || 'Intel'}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n\n      {/* Add Modal */}\n      {showAddModal && (\n        <div className=\"fixed inset-0 bg-black/70 flex items-center justify-center p-4 z-50\">\n          <div className=\"card w-full max-w-md bg-gray-900 border-gray-700\">\n            <h3 className=\"text-base font-bold text-white mb-3\">Add Threat Intelligence Entry</h3>\n            <form onSubmit={handleCreate} className=\"space-y-3\">\n              <div>\n                <label className=\"text-xs text-gray-400 block mb-1\">Package Name *</label>\n                <input\n                  className=\"input font-mono text-xs\"\n                  placeholder=\"e.g. malicious-event-stream\"\n                  value={form.package_name}\n                  onChange={e => setForm(f => ({ ...f, package_name: e.target.value }))}\n                  required\n                />\n              </div>\n              <div className=\"grid grid-cols-2 gap-2\">\n                <div>\n                  <label className=\"text-xs text-gray-400 block mb-1\">Ecosystem</label>\n                  <select\n                    className=\"select text-xs\"\n                    value={form.ecosystem}\n                    onChange={e => setForm(f => ({ ...f, ecosystem: e.target.value }))}\n                  >\n                    <option value=\"npm\">NPM</option>\n                    <option value=\"pypi\">PyPI</option>\n                    <option value=\"maven\">Maven</option>\n                    <option value=\"nuget\">NuGet</option>\n                    <option value=\"go\">Go</option>\n                    <option value=\"cargo\">Cargo</option>\n                  </select>\n                </div>\n                <div>\n                  <label className=\"text-xs text-gray-400 block mb-1\">Severity</label>\n                  <select\n                    className=\"select text-xs\"\n                    value={form.severity}\n                    onChange={e => setForm(f => ({ ...f, severity: e.target.value }))}\n                  >\n                    <option value=\"critical\">Critical</option>\n                    <option value=\"high\">High</option>\n                    <option value=\"medium\">Medium</option>\n                    <option value=\"low\">Low</option>\n                  </select>\n                </div>\n              </div>\n              <div>\n                <label className=\"text-xs text-gray-400 block mb-1\">Threat Type</label>\n                <select\n                  className=\"select text-xs\"\n                  value={form.threat_type}\n                  onChange={e => setForm(f => ({ ...f, threat_type: e.target.value }))}\n                >\n                  <option value=\"dependency_confusion\">Dependency Confusion</option>\n                  <option value=\"malicious_package\">Malicious Package</option>\n                  <option value=\"artifact_tampering\">Artifact Tampering</option>\n                  <option value=\"build_compromise\">Build Compromise</option>\n                  <option value=\"secret_leakage\">Secret Leakage</option>\n                  <option value=\"supply_chain_attack\">Supply Chain Attack</option>\n                  <option value=\"cve\">CVE</option>\n                </select>\n              </div>\n              <div>\n                <label className=\"text-xs text-gray-400 block mb-1\">CVE ID (Optional)</label>\n                <input\n                  className=\"input font-mono text-xs\"\n                  placeholder=\"e.g. CVE-2024-12345\"\n                  value={form.cve_id}\n                  onChange={e => setForm(f => ({ ...f, cve_id: e.target.value }))}\n                />\n              </div>\n              <div>\n                <label className=\"text-xs text-gray-400 block mb-1\">Description</label>\n                <textarea\n                  className=\"input text-xs\"\n                  rows={2}\n                  placeholder=\"Describe the threat pattern...\"\n                  value={form.description}\n                  onChange={e => setForm(f => ({ ...f, description: e.target.value }))}\n                />\n              </div>\n              <div className=\"flex gap-2 justify-end pt-2\">\n                <button type=\"button\" className=\"btn-secondary text-xs\" onClick={() => setShowAddModal(false)}>\n                  Cancel\n                </button>\n                <button type=\"submit\" className=\"btn-primary text-xs\">\n                  Save Signature\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n","Description":"Threat Intelligence management page","Overwrite":false,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\pages\\ThreatIntelPage.tsx","toolAction":"Writing ThreatIntelPage","toolSummary":"Threat intel page component"}}]}
