{"step_index":97,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-08T05:02:42Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { useEffect, useState } from 'react'\nimport { Wrench, CheckCircle2, Clock, XCircle } from 'lucide-react'\nimport { getProjects, getScans, getFindings, getRemediations, updateRemediation, type Project, type Remediation, type Finding } from '../api/client'\nimport { PageHeader, Spinner, ErrorBanner } from '../components/ui'\nimport { formatDate } from '../lib/constants'\n\ninterface ExtendedRemediation extends Remediation {\n  findingTitle?: string\n  package?: string\n  severity?: string\n}\n\nexport default function RemediationsPage() {\n  const [projects, setProjects] = useState<Project[]>([])\n  const [selectedProjectId, setSelectedProjectId] = useState<string>('')\n  const [remediations, setRemediations] = useState<ExtendedRemediation[]>([])\n  const [loading, setLoading] = useState(false)\n  const [error, setError] = useState('')\n\n  useEffect(() => {\n    getProjects().then(projs => {\n      setProjects(projs)\n      if (projs.length > 0) setSelectedProjectId(String(projs[0].id))\n    }).catch(() => setError('Failed to load projects'))\n  }, [])\n\n  useEffect(() => {\n    if (!selectedProjectId) return\n    setLoading(true)\n    getScans(Number(selectedProjectId)).then(async scans => {\n      if (scans.length === 0) {\n        setRemediations([])\n        setLoading(false)\n        return\n      }\n      const latestScan = scans[0]\n      const findings = await getFindings(Number(selectedProjectId), latestScan.id)\n      \n      const remPromises = findings.map(async f => {\n        const rems = await getRemediations(f.id)\n        return rems.map(r => ({\n          ...r,\n          findingTitle: f.title,\n          package: f.affected_package,\n          severity: f.severity,\n        }))\n      })\n\n      const nestedRems = await Promise.all(remPromises)\n      setRemediations(nestedRems.flat())\n    }).catch(() => setError('Failed to load remediations'))\n      .finally(() => setLoading(false))\n  }, [selectedProjectId])\n\n  const handleStatusChange = async (remId: number, status: any) => {\n    try {\n      await updateRemediation(remId, { status })\n      setRemediations(prev => prev.map(r => r.id === remId ? { ...r, status } : r))\n    } catch {\n      setError('Failed to update status')\n    }\n  }\n\n  return (\n    <div className=\"p-6\">\n      <PageHeader\n        title=\"Remediation Tracking\"\n        subtitle=\"Manage and track resolution of software supply chain security vulnerabilities\"\n      />\n\n      {error && <ErrorBanner message={error} />}\n\n      <div className=\"card mb-6\">\n        <div className=\"w-64\">\n          <label className=\"text-xs text-gray-400 block mb-1\">Select Project</label>\n          <select\n            className=\"select\"\n            value={selectedProjectId}\n            onChange={e => setSelectedProjectId(e.target.value)}\n          >\n            <option value=\"\">Select Project</option>\n            {projects.map(p => (\n              <option key={p.id} value={p.id}>{p.name}</option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      {loading ? (\n        <Spinner />\n      ) : remediations.length === 0 ? (\n        <div className=\"card text-center py-12\">\n          <Wrench size={36} className=\"text-gray-700 mx-auto mb-3\" />\n          <p className=\"text-gray-500\">No active remediation tasks for this project.</p>\n        </div>\n      ) : (\n        <div className=\"card overflow-hidden p-0\">\n          <table className=\"w-full text-sm\">\n            <thead>\n              <tr className=\"border-b border-gray-800\">\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Finding / Package</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Action</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Target Version</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Status</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Created</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Action</th>\n              </tr>\n            </thead>\n            <tbody>\n              {remediations.map(r => (\n                <tr key={r.id} className=\"table-row\">\n                  <td className=\"py-2.5 px-4\">\n                    <p className=\"text-xs font-semibold text-white\">{r.findingTitle}</p>\n                    <p className=\"text-xs font-mono text-sky-400\">{r.package}</p>\n                  </td>\n                  <td className=\"py-2.5 px-4 text-xs text-gray-300\">{r.action || '—'}</td>\n                  <td className=\"py-2.5 px-4 text-xs font-mono text-green-400\">{r.target_version || '—'}</td>\n                  <td className=\"py-2.5 px-4 text-xs\">\n                    <span className={`badge uppercase ${\n                      r.status === 'resolved' ? 'bg-green-900/50 text-green-300 border-green-800' :\n                      r.status === 'in_progress' ? 'bg-yellow-900/50 text-yellow-300 border-yellow-800' :\n                      'bg-red-900/50 text-red-300 border-red-800'\n                    }`}>\n                      {r.status.replace('_', ' ')}\n                    </span>\n                  </td>\n                  <td className=\"py-2.5 px-4 text-xs text-gray-500\">{formatDate(r.created_at)}</td>\n                  <td className=\"py-2.5 px-4 text-xs\">\n                    <select\n                      className=\"bg-gray-800 border border-gray-700 rounded px-2 py-1 text-xs text-gray-200\"\n                      value={r.status}\n                      onChange={e => handleStatusChange(r.id, e.target.value)}\n                    >\n                      <option value=\"open\">Open</option>\n                      <option value=\"in_progress\">In Progress</option>\n                      <option value=\"resolved\">Resolved</option>\n                      <option value=\"wont_fix\">Won't Fix</option>\n                      <option value=\"false_positive\">False Positive</option>\n                    </select>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n    </div>\n  )\n}\n","Description":"Remediations management page","Overwrite":false,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\pages\\Remediations.tsx","toolAction":"Writing Remediations page","toolSummary":"Remediations page component"}}]}
