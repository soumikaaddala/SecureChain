{"step_index":99,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-08T05:03:08Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { useEffect, useState } from 'react'\nimport { Database, ShieldCheck, ShieldAlert, CheckCircle2, XCircle } from 'lucide-react'\nimport { getProjects, getArtifacts, verifyArtifact, type Project, type Artifact } from '../api/client'\nimport { PageHeader, Spinner, ErrorBanner } from '../components/ui'\nimport { formatDate, formatSize } from '../lib/constants'\n\nexport default function ArtifactsPage() {\n  const [projects, setProjects] = useState<Project[]>([])\n  const [selectedProjectId, setSelectedProjectId] = useState<string>('')\n  const [artifacts, setArtifacts] = useState<Artifact[]>([])\n  const [loading, setLoading] = useState(false)\n  const [error, setError] = useState('')\n  const [verifyModalArtifact, setVerifyModalArtifact] = useState<Artifact | null>(null)\n  const [inputHash, setInputHash] = useState('')\n  const [verifying, setVerifying] = useState(false)\n\n  useEffect(() => {\n    getProjects().then(projs => {\n      setProjects(projs)\n      if (projs.length > 0) setSelectedProjectId(String(projs[0].id))\n    }).catch(() => setError('Failed to load projects'))\n  }, [])\n\n  useEffect(() => {\n    if (!selectedProjectId) return\n    setLoading(true)\n    getArtifacts(Number(selectedProjectId))\n      .then(setArtifacts)\n      .catch(() => setError('Failed to load artifacts'))\n      .finally(() => setLoading(false))\n  }, [selectedProjectId])\n\n  const handleVerify = async (e: React.FormEvent) => {\n    e.preventDefault()\n    if (!verifyModalArtifact || !inputHash.trim()) return\n    setVerifying(true)\n    setError('')\n    try {\n      await verifyArtifact(Number(selectedProjectId), verifyModalArtifact.id, inputHash.trim())\n      alert('Checksum verified successfully! Artifact is untampered.')\n      setVerifyModalArtifact(null)\n      setInputHash('')\n      // refresh\n      const updated = await getArtifacts(Number(selectedProjectId))\n      setArtifacts(updated)\n    } catch (err: any) {\n      setError(err.response?.data?.detail || 'Verification failed. Checksum mismatch detected!')\n    } finally {\n      setVerifying(false)\n    }\n  }\n\n  return (\n    <div className=\"p-6\">\n      <PageHeader\n        title=\"Build Artifacts Repository\"\n        subtitle=\"Manage build binaries, verify cryptographic hashes, and detect artifact tampering\"\n      />\n\n      {error && <ErrorBanner message={error} />}\n\n      <div className=\"card mb-6\">\n        <div className=\"w-64\">\n          <label className=\"text-xs text-gray-400 block mb-1\">Select Project</label>\n          <select\n            className=\"select\"\n            value={selectedProjectId}\n            onChange={e => setSelectedProjectId(e.target.value)}\n          >\n            <option value=\"\">Select Project</option>\n            {projects.map(p => (\n              <option key={p.id} value={p.id}>{p.name}</option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      {loading ? (\n        <Spinner />\n      ) : artifacts.length === 0 ? (\n        <div className=\"card text-center py-12\">\n          <Database size={36} className=\"text-gray-700 mx-auto mb-3\" />\n          <p className=\"text-gray-500\">No build artifacts registered for this project.</p>\n        </div>\n      ) : (\n        <div className=\"card overflow-hidden p-0\">\n          <table className=\"w-full text-sm\">\n            <thead>\n              <tr className=\"border-b border-gray-800\">\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Artifact Name</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Type / Version</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">SHA-256 Checksum</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Signature</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Tamper Status</th>\n                <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Actions</th>\n              </tr>\n            </thead>\n            <tbody>\n              {artifacts.map(a => (\n                <tr key={a.id} className=\"table-row\">\n                  <td className=\"py-2.5 px-4 font-mono text-xs text-white font-semibold\">{a.name}</td>\n                  <td className=\"py-2.5 px-4 text-xs text-gray-400\">{a.artifact_type || 'binary'} v{a.version || '1.0'}</td>\n                  <td className=\"py-2.5 px-4\">\n                    {a.sha256 ? (\n                      <span className=\"font-mono text-xs text-green-400\" title={a.sha256}>\n                        {a.sha256.slice(0, 16)}…\n                      </span>\n                    ) : (\n                      <span className=\"text-xs text-yellow-500\">Missing Hash</span>\n                    )}\n                  </td>\n                  <td className=\"py-2.5 px-4 text-xs\">\n                    {a.is_signed ? (\n                      <span className=\"text-green-400 inline-flex items-center gap-1\">\n                        <ShieldCheck size={13} /> Cosign Signed\n                      </span>\n                    ) : (\n                      <span className=\"text-gray-500\">Unsigned</span>\n                    )}\n                  </td>\n                  <td className=\"py-2.5 px-4 text-xs\">\n                    {a.tampered ? (\n                      <span className=\"text-red-400 font-bold inline-flex items-center gap-1\">\n                        <XCircle size={13} /> TAMPERED\n                      </span>\n                    ) : (\n                      <span className=\"text-green-500 inline-flex items-center gap-1\">\n                        <CheckCircle2 size={13} /> Clean\n                      </span>\n                    )}\n                  </td>\n                  <td className=\"py-2.5 px-4 text-xs\">\n                    <button\n                      onClick={() => setVerifyModalArtifact(a)}\n                      className=\"btn-secondary text-xs py-1 px-2.5\"\n                    >\n                      Verify Hash\n                    </button>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n\n      {/* Verify Checksum Modal */}\n      {verifyModalArtifact && (\n        <div className=\"fixed inset-0 bg-black/70 flex items-center justify-center p-4 z-50\">\n          <div className=\"card w-full max-w-md bg-gray-900 border-gray-700\">\n            <h3 className=\"text-base font-bold text-white mb-2\">Verify Artifact Hash</h3>\n            <p className=\"text-xs text-gray-400 mb-3\">{verifyModalArtifact.name}</p>\n            <form onSubmit={handleVerify} className=\"space-y-3\">\n              <div>\n                <label className=\"text-xs text-gray-400 block mb-1\">Expected SHA-256 Hash on record</label>\n                <div className=\"font-mono text-xs bg-gray-800 p-2 rounded text-green-400 break-all\">\n                  {verifyModalArtifact.sha256 || 'None'}\n                </div>\n              </div>\n              <div>\n                <label className=\"text-xs text-gray-400 block mb-1\">Enter Artifact Hash to Check</label>\n                <input\n                  className=\"input font-mono text-xs\"\n                  placeholder=\"Paste SHA-256 hash here...\"\n                  value={inputHash}\n                  onChange={e => setInputHash(e.target.value)}\n                  required\n                />\n              </div>\n              <div className=\"flex gap-2 justify-end pt-3\">\n                <button type=\"button\" className=\"btn-secondary text-xs\" onClick={() => setVerifyModalArtifact(null)}>\n                  Cancel\n                </button>\n                <button type=\"submit\" className=\"btn-primary text-xs\" disabled={verifying}>\n                  {verifying ? 'Verifying...' : 'Verify Hash Integrity'}\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n","Description":"Artifacts repository and integrity check page","Overwrite":false,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\pages\\ArtifactsPage.tsx","toolAction":"Writing ArtifactsPage","toolSummary":"Artifacts page component"}}]}
