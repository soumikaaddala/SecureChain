threatFilter])\n\n  const currentScan = scans.find(s => String(s.id) === selectedScan)\n\n  return (\n    <div className=\"p-6\">\n      <PageHeader\n        title=\"Security Scans\"\n        subtitle=\"View scan results and vulnerability findings\"\n      />\n\n      {error && <ErrorBanner message={error} />}\n\n      {/* Selectors */}\n      <div className=\"card mb-4\">\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-3\">\n          <div>\n            <label className=\"text-xs text-gray-400 block mb-1\">Project</label>\n            <select className=\"select\" value={selectedProject}\n              onChange={e => { setSelectedProject(e.target.value); setSelectedScan(''); setScans([]) }}>\n              <option value=\"\">— Select Project —</option>\n              {projects.map(p => <option key={p.id} value={p.id}>{p.name}</option>)}\n            </select>\n          </div>\n          <div>\n            <label className=\"text-xs text-gray-400 block mb-1\">Scan</label>\n            <select className=\"select\" value={selectedScan}\n              onChange={e => setSelectedScan(e.target.value)} disabled={!scans.length}>\n              <option value=\"\">— Select Scan —</option>\n              {scans.map(s => (\n                <option key={s.id} value={s.id}>\n                  Scan #{s.id} · {s.status} · {new Date(s.started_at).toLocaleDateString()}\n                </option>\n              ))}\n            </select>\n          </div>\n          <div>\n            <label className=\"text-xs text-gray-400 block mb-1\">Severity Filter</label>\n            <select className=\"select\" value={severityFilter}\n              onChange={e => setSeverityFilter(e.target.value)}>\n              <option value=\"\">All Severities</option>\n              {SEVERITIES.map(s => <option key={s} value={s}>{s.charAt(0).toUpperCase() + s.slice(1)}</option>)}\n            </select>\n          </div>\n          <div>\n            <label className=\"text-xs text-gray-400 block mb-1\">Threat Type</label>\n            <select className=\"select\" value={threatFilter}\n              onChange={e => setThreatFilter(e.target.value)}>\n              <option value=\"\">All Threats</option>\n              {THREATS.map(t => <option key={t} value={t}>{THREAT_LABELS[t as keyof typeof THREAT_LABELS]}</option>)}\n            </select>\n          </div>\n        </div>\n      </div>\n\n      {/* Scan Summary */}\n      {currentScan && (\n        <div className=\"card mb-4\">\n          <div className=\"flex items-center justify-between mb-3\">\n            <h3 className=\"text-sm font-semibold text-gray-200\">\n              Scan #{currentScan.id} Summary\n            </h3>\n            <ScanStatusBadge status={currentScan.status} />\n          </div>\n          <div className=\"grid grid-cols-3 md:grid-cols-6 gap-3 text-center\">\n            {[\n              { label: 'Critical', value: currentScan.critical_count, color: 'text-red-400' },\n              { label: 'High', value: currentScan.high_count, color: 'text-orange-400' },\n              { label: 'Medium', value: currentScan.medium_count, color: 'text-yellow-400' },\n              { label: 'Low', value: currentScan.low_count, color: 'text-blue-400' },\n              { label: 'Deps Scanned', value: currentScan.total_deps_scanned, color: 'text-gray-300' },\n              { label: 'Risk Score', value: currentScan.risk_score.toFixed(1), color: currentScan.risk_score >= 50 ? 'text-red-400' : 'text-green-400' },\n            ].map(item => (\n              <div key={item.label}>\n                <p className={clsx('text-2xl font-bold', item.color)}>{item.value}</p>\n                <p className=\"text-xs text-gray-500\">{item.label}</p>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* Findings Table */}\n      {!selectedProject ? (\n        <div className=\"card text-center py-12\">\n          <AlertTriangle size={36} className=\"text-gray-700 mx-auto mb-3\" />\n          <p className=\"text-gray-500\">Select a project and scan to view findings</p>\n        </div>\n      ) : loading ? <Spinner /> : findings.length === 0 ? (\n        <div className=\"card text-center py-12\">\n          <p className=\"text-gray-500\">\n            {selectedScan ? 'No findings match your filters' : 'Select a scan to view findings'}\n          </p>\n        </div>\n      ) : (\n        <div className=\"card overflow-hidden p-0\">\n          <div className=\"px-5 py-3 border-b border-gray-800 flex items-center justify-between\">\n            <h3 className=\"text-sm font-semibold text-gray-200\">\n              {findings.length} Finding{findings.length !== 1 ? 's' : ''}\n            </h3>\n          </div>\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-sm\">\n              <thead>\n                <tr className=\"border-b border-gray-800\">\n                  <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Severity</th>\n                  <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Threat Type</th>\n                  <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Title</th>\n                  <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Package</th>\n                  <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">CVE</th>\n                  <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">CVSS</th>\n                  <th className=\"text-left py-3 px-4 text-xs text-gray-500 font-medium\">Fix</th>\n                </tr>\n              </thead>\n              <tbody>\n                {findings.map(f => (\n                  <FindingRow key={f.id} finding={f} />\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n\nfunction FindingRow({ finding: f }: { finding: Finding }) {\n  const [expanded, setExpanded] = useState(false)\n  return (\n    <>\n      <tr\n        className=\"table-row cursor-pointer\"\n        onClick={() => setExpanded(e => !e)}\n      >\n        <td className=\"py-2.5 px-4\"><SeverityBadge severity={f.severity} /></td>\n        <td className=\"py-2.5 px-4\"><ThreatBadge type={f.threat_type} /></td>\n        <td className=\"py-2.5 px-4 text-xs text-gray-200 max-w-xs\">\n          <div className=\"truncate\">{f.title}</div>\n        </td>\n        <td className=\"py-2.5 px-4 font-mono text-xs text-sky-400\">\n          {f.affected_package}\n          {f.affected_version && <span className=\"text-gray-500\">@{f.affected_version}</span>}\n        </td>\n        <td className=\"py-2.5 px-4 text-xs\">\n          {f.cve_id ? (\n            <a\n              href={`https://nvd.nist.gov/vuln/detail/${f.cve_id}`}\n              target=\"_blank\" rel=\"noreferrer\"\n              className=\"text-sky-500 hover:text-sky-400 underline\"\n              onClick={e => e.stopPropagation()}\n            >\n              {f.cve_id}\n            </a>\n          ) : '—'}\n        </td>\n        <td className=\"py-2.5 px-4 text-xs\">\n          {f.cvss_score !== undefined && f.cvss_score !== null ? (\n            <span className={clsx('font-mono font-semibold',\n              f.cvss_score >= 9 ? 'text-red-400' :\n              f.cvss_score >= 7 ? 'text-orange-400' :\n              f.cvss_score >= 4 ? 'text-yellow-400' : 'text-gray-400'\n            )}>\n              {f.cvss_score.toFixed(1)}\n            </span>\n          ) : '—'}\n        </td>\n        <td className=\"py-2.5 px-4 text-xs text-green-400\">\n          {f.fixed_in_version ? `→ ${f.fixed_in_version}` : '—'}\n        </td>\n      </tr>\n      {expanded && (\n        <tr className=\"bg-gray-800/30\">\n          <td colSpan={7} className=\"px-4 py-3\">\n            <div className=\"text-xs text-gray-300 space-y-1.5\">\n              {f.description && <p>{f.description}</p>}\n              {f.evidence && (\n                <details className=\"mt-2\">\n                  <summary className=\"cursor-pointer text-gray-500 hover:text-gray-400\">Evidence</summary>\n                  <pre className=\"mt-1 bg-gray-900 rounded p-2 text-xs overflow-x-auto\">\n                    {JSON.stringify(f.evidence, null, 2)}\n                  </pre>\n                </details>\n              )}\n            </div>\n          </td>\n        </tr>\n      )}\n    </>\n  )\n}\n","Description":"Scans and findings page with filtering","Overwrite":false,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\pages\\Scans.tsx","toolAction":"Writing Scans page","toolSummary":"Scans page component"}}]}
