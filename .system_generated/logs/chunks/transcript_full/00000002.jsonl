{"step_index":82,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-08T04:53:30Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { useEffect, useState } from 'react'\nimport { useParams, useNavigate } from 'react-router-dom'\nimport { ArrowLeft, Download, CheckCircle, XCircle, AlertTriangle } from 'lucide-react'\nimport { getRiskReport, type RiskReport } from '../api/client'\nimport { SeverityBadge, ThreatBadge, Spinner, ErrorBanner } from '../components/ui'\nimport { formatDate } from '../lib/constants'\nimport {\n  RadarChart, Radar, PolarGrid, PolarAngleAxis, ResponsiveContainer,\n  BarChart, Bar, XAxis, YAxis, Tooltip\n} from 'recharts'\nimport clsx from 'clsx'\n\nconst CHART_STYLE = { fontSize: 10, fill: '#94a3b8' }\n\nexport default function ReportPage() {\n  const { id } = useParams<{ id: string }>()\n  const projectId = Number(id)\n  const navigate = useNavigate()\n  const [report, setReport] = useState<RiskReport | null>(null)\n  const [loading, setLoading] = useState(true)\n  const [error, setError] = useState('')\n\n  useEffect(() => {\n    getRiskReport(projectId)\n      .then(setReport)\n      .catch(e => setError(e.response?.data?.detail || 'Failed to generate report'))\n      .finally(() => setLoading(false))\n  }, [projectId])\n\n  if (loading) return <Spinner />\n  if (error) return (\n    <div className=\"p-6\">\n      <button onClick={() => navigate(-1)} className=\"btn-secondary text-xs mb-4\">\n        <ArrowLeft size={13} /> Back\n      </button>\n      <ErrorBanner message={error} />\n    </div>\n  )\n  if (!report) return null\n\n  const threatData = Object.entries(report.threat_breakdown)\n    .map(([k, v]) => ({\n      name: k.replace(/_/g, ' ').replace(/\\b\\w/g, c => c.toUpperCase()),\n      value: v,\n    }))\n\n  const radarData = [\n    { subject: 'Critical', value: report.critical_count, max: 10 },\n    { subject: 'High', value: report.high_count, max: 10 },\n    { subject: 'Medium', value: report.medium_count, max: 10 },\n    { subject: 'Low', value: report.low_count, max: 10 },\n    { subject: 'Open Rem.', value: report.remediation_summary?.open || 0, max: 10 },\n  ]\n\n  const riskColor =\n    report.risk_score >= 75 ? 'text-red-400' :\n    report.risk_score >= 50 ? 'text-orange-400' :\n    report.risk_score >= 25 ? 'text-yellow-400' : 'text-green-400'\n\n  return (\n    <div className=\"p-6 max-w-6xl\">\n      {/* Header */}\n      <div className=\"flex items-center gap-3 mb-6\">\n        <button onClick={() => navigate(-1)} className=\"p-2 rounded-lg text-gray-500 hover:text-gray-300 hover:bg-gray-800 transition-colors\">\n          <ArrowLeft size={16} />\n        </button>\n        <div className=\"flex-1\">\n          <h1 className=\"text-xl font-bold text-white\">Risk Report — {report.project_name}</h1>\n          <p className=\"text-xs text-gray-500\">Generated {formatDate(report.generated_at)}</p>\n        </div>\n        <button\n          onClick={() => {\n            const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' })\n            const url = URL.createObjectURL(blob)\n            const a = document.createElement('a')\n            a.href = url; a.download = `${report.project_name}-risk-report.json`; a.click()\n          }}\n          className=\"btn-secondary text-xs\"\n        >\n          <Download size={13} /> Export JSON\n        </button>\n      </div>\n\n      {/* Risk Score Banner */}\n      <div className={clsx(\n        'card mb-6 border-2',\n        report.risk_score >= 75 ? 'border-red-800 bg-red-900/10' :\n        report.risk_score >= 50 ? 'border-orange-800 bg-orange-900/10' :\n        report.risk_score >= 25 ? 'border-yellow-800 bg-yellow-900/10' : 'border-green-800 bg-green-900/10'\n      )}>\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <p className=\"text-xs text-gray-500 uppercase tracking-wide mb-1\">Overall Risk Score</p>\n            <p className={clsx('text-5xl font-black', riskColor)}>{report.risk_score.toFixed(1)}</p>\n            <p className=\"text-sm text-gray-400 mt-1\">\n              {report.risk_score >= 75 ? 'Critical Risk — Immediate action required' :\n               report.risk_score >= 50 ? 'High Risk — Address findings promptly' :\n               report.risk_score >= 25 ? 'Medium Risk — Plan remediations' : 'Low Risk — Continue monitoring'}\n            </p>\n          </div>\n          <div className=\"grid grid-cols-4 gap-6 text-center\">\n            {[\n              { label: 'Critical', v: report.critical_count, c: 'text-red-400' },\n              { label: 'High', v: report.high_count, c: 'text-orange-400' },\n              { label: 'Medium', v: report.medium_count, c: 'text-yellow-400' },\n              { label: 'Low', v: report.low_count, c: 'text-blue-400' },\n            ].map(item => (\n              <div key={item.label}>\n                <p className={clsx('text-3xl font-bold', item.c)}>{item.v}</p>\n                <p className=\"text-xs text-gray-500\">{item.label}</p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Metrics Row */}\n      <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 mb-6\">\n        {[\n          { label: 'Total Dependencies', value: report.total_dependencies },\n          { label: 'Direct', value: report.direct_dependencies },\n          { label: 'Transitive', value: report.transitive_dependencies },\n          { label: 'Total Findings', value: report.total_findings },\n        ].map(item => (\n          <div key={item.label} className=\"card text-center\">\n            <p className=\"text-2xl font-bold text-white\">{item.value}</p>\n            <p className=\"text-xs text-gray-500 mt-1\">{item.label}</p>\n          </div>\n        ))}\n      </div>\n\n      {/* Charts */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 mb-6\">\n        <div className=\"card\">\n          <h3 className=\"text-sm font-semibold text-gray-300 mb-3\">Threat Breakdown</h3>\n          <ResponsiveContainer width=\"100%\" height={180}>\n            <BarChart data={threatData} layout=\"vertical\">\n              <XAxis type=\"number\" tick={CHART_STYLE} axisLine={false} tickLine={false} />\n              <YAxis type=\"category\" dataKey=\"name\" tick={{ ...CHART_STYLE, fontSize: 9 }} width={130} axisLine={false} tickLine={false} />\n              <Tooltip contentStyle={{ background: '#1f2937', border: '1px solid #374151', borderRadius: 8 }}\n                itemStyle={{ color: '#e2e8f0' }} />\n              <Bar dataKey=\"value\" fill=\"#f97316\" radius={[0, 4, 4, 0]} />\n            </BarChart>\n          </ResponsiveContainer>\n        </div>\n        <div className=\"card\">\n          <h3 className=\"text-sm font-semibold text-gray-300 mb-3\">Severity Radar</h3>\n          <ResponsiveContainer width=\"100%\" height={180}>\n            <RadarChart data={radarData}>\n              <PolarGrid stroke=\"#374151\" />\n              <PolarAngleAxis dataKey=\"subject\" tick={CHART_STYLE} />\n              <Radar dataKey=\"value\" stroke=\"#0ea5e9\" fill=\"#0ea5e9\" fillOpacity={0.3} />\n            </RadarChart>\n          </ResponsiveContainer>\n        </div>\n      </div>\n\n      {/* Recommendations */}\n      <div className=\"card mb-6\">\n        <h3 className=\"text-sm font-semibold text-gray-200 mb-3\">🛡️ Recommendations</h3>\n        <div className=\"space-y-2\">\n          {report.recommendations.map((rec, i) => (\n            <div key={i} className=\"flex items-start gap-2 p-3 bg-gray-800/50 rounded-lg\">\n              <CheckCircle size={14} className=\"text-sky-400 mt-0.5 flex-shrink-0\" />\n              <p className=\"text-xs text-gray-300\">{rec}</p>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Top Findings */}\n      <div className=\"card mb-6\">\n        <h3 className=\"text-sm font-semibold text-gray-200 mb-3\">Top Findings</h3>\n        <div className=\"space-y-2\">\n          {report.top_findings.map(f => (\n            <div key={f.id} className=\"flex items-center gap-3 p-3 bg-gray-800/40 rounded-lg\">\n              <SeverityBadge severity={f.severity} />\n              <ThreatBadge type={f.threat_type} />\n              <div className=\"flex-1 min-w-0\">\n                <p className=\"text-xs font-medium text-gray-200 truncate\">{f.title}</p>\n                <p className=\"text-xs text-gray-500\">{f.affected_package}{f.affected_version ? `@${f.affected_version}` : ''}</p>\n              </div>\n              {f.cve_id && (\n                <a href={`https://nvd.nist.gov/vuln/detail/${f.cve_id}`} target=\"_blank\" rel=\"noreferrer\"\n                  className=\"text-xs text-sky-500 hover:text-sky-400 flex-shrink-0\">\n                  {f.cve_id}\n                </a>\n              )}\n              {f.cvss_score !== undefined && (\n                <span className={clsx('text-xs font-mono font-bold flex-shrink-0',\n                  (f.cvss_score ?? 0) >= 9 ? 'text-red-400' : (f.cvss_score ?? 0) >= 7 ? 'text-orange-400' : 'text-yellow-400'\n                )}>\n                  {f.cvss_score?.toFixed(1)}\n                </span>\n              )}\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Remediation Summary */}\n      <div className=\"card\">\n        <h3 className=\"text-sm font-semibold text-gray-200 mb-3\">Remediation Summary</h3>\n        <div className=\"flex flex-wrap gap-3\">\n          {Object.entries(report.remediation_summary).map(([status, count]) => (\n            <div key={status} className=\"flex items-center gap-2 px-3 py-2 bg-gray-800 rounded-lg\">\n              <span className=\"text-xs text-gray-400 capitalize\">{status.replace(/_/g, ' ')}</span>\n              <span className=\"text-sm font-bold text-white\">{count}</span>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  )\n}\n","Description":"Comprehensive risk report page with charts and export","Overwrite":false,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\pages\\Report.tsx","toolAction":"Writing Report page","toolSummary":"Risk report page"}}]}
