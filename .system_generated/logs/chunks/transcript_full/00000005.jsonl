{"step_index":304,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-08T10:15:46Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { Shield, LayoutDashboard, FolderGit2, Package, Search, FileText, Wrench, AlertTriangle, Database, Activity, LogOut, User as UserIcon } from 'lucide-react'\nimport { Link, useLocation } from 'react-router-dom'\nimport clsx from 'clsx'\nimport { useAuth } from '../context/AuthContext'\n\nconst NAV = [\n  { to: '/',            icon: LayoutDashboard, label: 'Dashboard' },\n  { to: '/projects',    icon: FolderGit2,      label: 'Projects' },\n  { to: '/dependencies',icon: Package,         label: 'Dependencies' },\n  { to: '/scans',       icon: Search,          label: 'Security Scans' },\n  { to: '/findings',    icon: AlertTriangle,   label: 'Vulnerabilities' },\n  { to: '/remediations',icon: Wrench,          label: 'Remediations' },\n  { to: '/artifacts',   icon: Database,        label: 'Artifact Store' },\n  { to: '/reports',     icon: FileText,        label: 'Risk Reports' },\n  { to: '/threat-intel',icon: Shield,          label: 'Threat Intel' },\n]\n\nconst ROLE_BADGES: Record<string, string> = {\n  'Developer': 'bg-sky-500/10 text-sky-400 border-sky-500/20',\n  'Security Administrator': 'bg-purple-500/10 text-purple-400 border-purple-500/20',\n  'Project Administrator': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',\n  'System Administrator': 'bg-amber-500/10 text-amber-400 border-amber-500/20',\n}\n\nexport default function Sidebar() {\n  const { pathname } = useLocation()\n  const { user, logout } = useAuth()\n\n  return (\n    <aside className=\"w-64 min-h-screen bg-[#0d1322] border-r border-gray-800/80 flex flex-col flex-shrink-0\">\n      {/* Brand Header */}\n      <div className=\"px-5 py-5 border-b border-gray-800/80\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-500 to-blue-600 flex items-center justify-center flex-shrink-0 shadow-lg shadow-sky-500/25\">\n            <Shield size={18} className=\"text-white\" />\n          </div>\n          <div>\n            <div className=\"text-sm font-bold text-white tracking-wide flex items-center gap-1.5\">\n              SecureChain <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" />\n            </div>\n            <div className=\"text-[11px] text-sky-400 font-medium\">Supply Chain Security</div>\n          </div>\n        </div>\n      </div>\n\n      {/* User Profile Info Card */}\n      {user && (\n        <div className=\"mx-3 mt-4 p-3 rounded-xl bg-gray-900/80 border border-gray-800 flex items-center justify-between gap-2\">\n          <div className=\"flex items-center gap-2.5 min-w-0\">\n            <div className=\"w-7 h-7 rounded-lg bg-gray-800 flex items-center justify-center text-sky-400 flex-shrink-0\">\n              <UserIcon size={14} />\n            </div>\n            <div className=\"min-w-0\">\n              <div className=\"text-xs font-semibold text-white truncate\">{user.username}</div>\n              <span className={clsx('badge text-[9px] py-0 px-1.5 border mt-0.5', ROLE_BADGES[user.role] || 'bg-gray-800 text-gray-400')}>\n                {user.role}\n              </span>\n            </div>\n          </div>\n          <button\n            onClick={logout}\n            title=\"Sign Out\"\n            className=\"p-1.5 rounded-lg text-gray-500 hover:text-red-400 hover:bg-red-950/30 transition-colors flex-shrink-0\"\n          >\n            <LogOut size={14} />\n          </button>\n        </div>\n      )}\n\n      {/* Navigation */}\n      <nav className=\"flex-1 px-3 py-4 space-y-1\">\n        <div className=\"px-3 pb-2 text-[10px] font-semibold uppercase tracking-wider text-gray-500\">\n          Core Workflows\n        </div>\n        {NAV.map(({ to, icon: Icon, label }) => {\n          const active = pathname === to || (to !== '/' && pathname.startsWith(to))\n          return (\n            <Link\n              key={to}\n              to={to}\n              className={clsx(\n                'flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-medium transition-all duration-150 group relative',\n                active\n                  ? 'bg-sky-500/10 text-sky-400 font-semibold border border-sky-500/20 shadow-sm'\n                  : 'text-gray-400 hover:text-gray-100 hover:bg-gray-800/60'\n              )}\n            >\n              {active && (\n                <span className=\"absolute left-0 top-1.5 bottom-1.5 w-1 rounded-r-full bg-sky-500 shadow-sm shadow-sky-500\" />\n              )}\n              <Icon size={16} className={clsx('flex-shrink-0 transition-colors', active ? 'text-sky-400' : 'text-gray-500 group-hover:text-gray-300')} />\n              <span>{label}</span>\n            </Link>\n          )\n        })}\n      </nav>\n\n      {/* Footer Info */}\n      <div className=\"p-4 border-t border-gray-800/80 bg-gray-950/40\">\n        <div className=\"flex items-center gap-2 text-xs text-gray-400 mb-1\">\n          <Activity size={12} className=\"text-emerald-400\" />\n          <span className=\"font-semibold text-gray-300\">Scanner Engine</span>\n        </div>\n        <div className=\"text-[11px] text-gray-500\">v1.0.0 · Active Monitoring</div>\n      </div>\n    </aside>\n  )\n}\n","Description":"Sidebar updated with user profile and logout support","Overwrite":true,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\components\\Sidebar.tsx","toolAction":"Updating Sidebar for Auth profile","toolSummary":"Update Sidebar auth profile"}}]}
