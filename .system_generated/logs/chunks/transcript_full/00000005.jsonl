{"step_index":302,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-08T10:15:29Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState } from 'react'\nimport { useNavigate } from 'react-router-dom'\nimport { Shield, Lock, User as UserIcon, LogIn, CheckCircle2, AlertCircle } from 'lucide-react'\nimport { useAuth } from '../context/AuthContext'\n\nconst PRESET_ACCOUNTS = [\n  {\n    role: 'Developer',\n    username: 'developer',\n    password: 'DevPass123!',\n    badge: 'bg-sky-500/10 text-sky-400 border-sky-500/20',\n    description: 'Registers projects, manages dependencies, runs scans & tracks remediations.',\n  },\n  {\n    role: 'Security Administrator',\n    username: 'sec_admin',\n    password: 'SecAdminPass123!',\n    badge: 'bg-purple-500/10 text-purple-400 border-purple-500/20',\n    description: 'Monitors security findings, reviews risk reports & verifies remediations.',\n  },\n  {\n    role: 'Project Administrator',\n    username: 'proj_admin',\n    password: 'ProjAdminPass123!',\n    badge: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',\n    description: 'Manages projects, project metadata, dependency trees & build artifacts.',\n  },\n  {\n    role: 'System Administrator',\n    username: 'sys_admin',\n    password: 'SysAdminPass123!',\n    badge: 'bg-amber-500/10 text-amber-400 border-amber-500/20',\n    description: 'Maintains platform services, database, threat feeds & access permissions.',\n  },\n]\n\nexport default function Login() {\n  const [username, setUsername] = useState('')\n  const [password, setPassword] = useState('')\n  const [loading, setLoading] = useState(false)\n  const [error, setError] = useState('')\n\n  const { login } = useAuth()\n  const navigate = useNavigate()\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault()\n    if (!username || !password) {\n      setError('Please provide both username and password.')\n      return\n    }\n\n    setLoading(true)\n    setError('')\n    try {\n      await login(username, password)\n      navigate('/')\n    } catch (err: any) {\n      setError(err.response?.data?.detail || 'Authentication failed. Please check credentials.')\n    } finally {\n      setLoading(false)\n    }\n  }\n\n  const fillPreset = (u: string, p: string) => {\n    setUsername(u)\n    setPassword(p)\n    setError('')\n  }\n\n  return (\n    <div className=\"min-h-screen bg-[#090d16] flex items-center justify-center p-4 relative overflow-hidden\">\n      {/* Dynamic Background Accents */}\n      <div className=\"absolute -top-40 -left-40 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none\" />\n      <div className=\"absolute -bottom-40 -right-40 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"w-full max-w-5xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center z-10\">\n        {/* Left Form Box */}\n        <div className=\"lg:col-span-6 card bg-[#111827]/90 border-gray-800 p-8 shadow-2xl relative\">\n          <div className=\"flex items-center gap-3 mb-6\">\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-blue-600 flex items-center justify-center shadow-lg shadow-sky-500/25\">\n              <Shield size={20} className=\"text-white\" />\n            </div>\n            <div>\n              <h1 className=\"text-xl font-bold text-white tracking-wide\">SecureChain</h1>\n              <p className=\"text-xs text-sky-400 font-medium\">Software Supply Chain Security</p>\n            </div>\n          </div>\n\n          <h2 className=\"text-lg font-semibold text-gray-200 mb-1\">Sign In to Platform</h2>\n          <p className=\"text-xs text-gray-400 mb-6\">Enter your credentials to access security workflows.</p>\n\n          {error && (\n            <div className=\"mb-5 p-3 rounded-lg bg-red-950/40 border border-red-800/60 text-xs text-red-300 flex items-center gap-2\">\n              <AlertCircle size={14} className=\"flex-shrink-0\" />\n              <span>{error}</span>\n            </div>\n          )}\n\n          <form onSubmit={handleSubmit} className=\"space-y-4\">\n            <div>\n              <label className=\"block text-xs font-medium text-gray-300 mb-1\">Username</label>\n              <div className=\"relative\">\n                <UserIcon size={14} className=\"absolute left-3 top-3 text-gray-500\" />\n                <input\n                  type=\"text\"\n                  className=\"input pl-9\"\n                  placeholder=\"e.g. developer\"\n                  value={username}\n                  onChange={e => setUsername(e.target.value)}\n                  required\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-medium text-gray-300 mb-1\">Password</label>\n              <div className=\"relative\">\n                <Lock size={14} className=\"absolute left-3 top-3 text-gray-500\" />\n                <input\n                  type=\"password\"\n                  className=\"input pl-9\"\n                  placeholder=\"••••••••••••\"\n                  value={password}\n                  onChange={e => setPassword(e.target.value)}\n                  required\n                />\n              </div>\n            </div>\n\n            <button\n              type=\"submit\"\n              disabled={loading}\n              className=\"btn-primary w-full py-2.5 text-xs font-semibold mt-2\"\n            >\n              {loading ? (\n                <span className=\"flex items-center gap-2\">\n                  <span className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                  Authenticating...\n                </span>\n              ) : (\n                <span className=\"flex items-center gap-2\">\n                  <LogIn size={15} /> Sign In\n                </span>\n              )}\n            </button>\n          </form>\n        </div>\n\n        {/* Right Role Preset Helper Cards */}\n        <div className=\"lg:col-span-6 space-y-3\">\n          <div className=\"mb-2\">\n            <h3 className=\"text-sm font-bold text-gray-200 uppercase tracking-wider text-xs\">\n              Demonstration Role Accounts\n            </h3>\n            <p className=\"text-xs text-gray-400 mt-0.5\">\n              Click any role card below to quickly auto-fill demonstration login credentials:\n            </p>\n          </div>\n\n          {PRESET_ACCOUNTS.map(acc => (\n            <div\n              key={acc.role}\n              onClick={() => fillPreset(acc.username, acc.password)}\n              className=\"card bg-gray-900/60 border-gray-800/80 hover:border-sky-500/50 cursor-pointer transition-all p-4 group\"\n            >\n              <div className=\"flex items-start justify-between mb-1\">\n                <span className={`badge border ${acc.badge}`}>\n                  {acc.role}\n                </span>\n                <span className=\"text-[11px] font-mono text-gray-400 group-hover:text-sky-400 transition-colors\">\n                  {acc.username}\n                </span>\n              </div>\n              <p className=\"text-xs text-gray-400 leading-relaxed mt-1\">{acc.description}</p>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  )\n}\n","Description":"Modern glassmorphic Login Page component with role preset helpers","Overwrite":true,"TargetFile":"c:\\Users\\addal\\Documents\\antigravity\\focused-bell\\frontend\\src\\pages\\Login.tsx","toolAction":"Writing Login page component","toolSummary":"Create Login page"}}]}
